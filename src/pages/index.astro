                  <span class="blog-curator-name">{curatorName} tuyển chọn 🐾</span>
                </div>
                
                <p class="blog-item-desc">{post.data.description}</p>
                
                <div class="blog-item-metrics">
                  <span class="metric-tag"><i class="ph-light ph-clock"></i> {readingTime} đọc</span>
                  <span class="metric-tag"><i class="ph-light ph-sparkles"></i> Xoa dịu: {healingIndex}</span>
                </div>

                <div class="blog-meta">
                  <span class="blog-date">{post.data.publishDate}</span>
                  <a href={`/blog/${post.slug}`} class="cozy-dotted-link read-more">Đọc bài viết <i class="ph-light ph-arrow-right"></i></a>
                </div>
              </article>
            );
          })}
