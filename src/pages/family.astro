---
import Layout from '../layouts/Layout.astro';
import familyData from '../data/family.json';

// Tải danh sách hình ảnh gia đình từ JSON
const familyPhotos = [];

// Đọc thông tin kết nối Supabase và Gemini từ biến môi trường
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const geminiApiKey = import.meta.env.PUBLIC_GEMINI_API_KEY || '';
---


<Layout 
  title="Góc Nhỏ Gia Đình | doca.pet" 
  description="Nơi cất giữ những khoảnh khắc ấm áp và mộc mạc của gia đình nhà DOCA. Mời cô/chú và các bạn đồng Meo lật xem từng bức ảnh chụp kỷ niệm của tụi con nhé. 🐾"
>
  <!-- Truyền biến môi trường sang client-side -->
  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey, geminiApiKey }}>
    window.PUBLIC_SUPABASE_URL = supabaseUrl;
    window.PUBLIC_SUPABASE_ANON_KEY = supabaseAnonKey;
    window.PUBLIC_GEMINI_API_KEY = geminiApiKey;
  </script>

  <!-- Nhúng các script CDN phục vụ kiểm duyệt ảnh mèo -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@2.1.1/dist/mobilenet.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/exif-js"></script>

  <main class="family-page-view">
    <!-- Navbar -->
    <nav class="navbar">
      <div class="container nav-container">
        <!-- Hamburger toggle -->
        <button id="menu-toggle-btn" class="menu-toggle" aria-label="Menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <a href="/" class="logo-wrapper">
          <img src="/images/brand/logo-light.png" alt="doca.pet Logo" class="brand-logo-img" />
        </a>
        <div class="nav-right">
          <!-- Desktop navigation links -->
          <div class="nav-links-desktop">
            <a href="/product" class="nav-link-text">Sản phẩm</a>
            <a href="/music" class="nav-link-text">Music</a>
            <a href="/family" class="nav-link-text active">Gia đình</a>
            <a href="/blog" class="nav-link-text">Blog</a>
            <a href="/about" class="nav-link-text">About Us</a>
          </div>

          <div id="nav-auth-container-desktop" class="nav-auth-container"></div>
        </div>
      </div>
      <!-- Mobile navigation menu -->
      <div id="mobile-menu" class="mobile-menu">
        <div class="container mobile-menu-container">
          <a href="/product" class="mobile-menu-link"><i class="ph-light ph-circles-four"></i> Sản phẩm</a>
          <a href="/music" class="mobile-menu-link"><i class="ph-light ph-music-notes"></i> Music</a>
          <a href="/family" class="mobile-menu-link active"><i class="ph-light ph-users"></i> Gia đình</a>
          <a href="/blog" class="mobile-menu-link"><i class="ph-light ph-book-open"></i> Blog</a>
          <a href="/about" class="mobile-menu-link"><i class="ph-light ph-info"></i> About Us</a>
          <div id="nav-auth-container-mobile" class="nav-auth-container-mobile"></div>
        </div>
      </div>
    </nav>

    <div class="container content-container">
      <!-- Header góc gia đình (Đồng bộ kiểu dáng và phông chữ giống hình minh họa) -->
      <div class="family-header animate-fade-in">
        <span class="family-tag">GÓC NHỎ DOCA</span>
        <h1 class="family-page-title">Góc Nhỏ Gia Đình</h1>
        <p class="family-page-subtitle animate-fade-in-delayed">
          mỗi bức ảnh là một lát cắt thời gian dịu êm mẹ Lin chụp cho tụi con... 🐾
        </p>
      </div>

      <!-- Pinterest-style Masonry Grid (Khoảng cách mỏng hơn cho hình to ra) -->
      <div class="family-masonry-grid" id="family-masonry-grid">
        {familyPhotos.map((photo, index) => (
          <div class={`polaroid-card ${index >= 14 ? 'hidden-card' : ''}`} data-id={photo.id} data-type="static">
            <div class="polaroid-card-inner">
              
              <!-- Mặt trước: Thẻ ảnh Muji viền mỏng bo nhọn, watermark trên hình, chân hình trống -->
              <div class="card-front">
                <div class="polaroid-frame">
                  <div class="photo-wrapper" style={`aspect-ratio: ${photo.aspectRatio || '1/1'};`}>
                    <img src={photo.imageUrl} alt={photo.title} class="polaroid-photo" loading="lazy" />
                    <span class="photo-watermark">@capcat.family</span>
                  </div>
                  <!-- Chân hình bỏ trống không có chữ -->
                </div>
              </div>

              <!-- Mặt sau: Ghi chú dùng Space Mono tối giản, viền mỏng bo nhọn -->
              <div class="card-back">
                <div class="note-paper">
                  <div class="note-content-wrapper">
                    {photo.note && <p class="note-monospace">{photo.note}</p>}


                    <div class="note-footer">
                      <span class="note-tag">#family</span>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Nút xem thêm tối giản phong cách Muji phối màu Matcha -->
      <div class="load-more-container animate-fade-in-delayed">
        <button id="load-more-btn" class="load-more-btn">
          Xem thêm khoảnh khắc <i class="ph-light ph-caret-down"></i>
        </button>
      </div>
    </div>

    <!-- Floating Action Button để đăng hình mới -->
    <button id="upload-photo-trigger" class="floating-upload-btn" title="Gửi khoảnh khắc bé cưng 🐾">
      <i class="ph-light ph-camera"></i>
    </button>

    <!-- Bottom Sheet Đăng Ảnh -->
    <div id="upload-photo-modal" class="sheet-overlay">
      <div class="polaroid-bottom-sheet-upload">
        <!-- Thanh kéo chỉ báo vuốt/kéo phong cách native mobile -->
        <div class="sheet-drag-handle"></div>
        <button id="modal-close-btn" class="bottom-sheet-close-btn" aria-label="Đóng">
          <i class="ph-light ph-x"></i>
        </button>
        <h3 class="bottom-sheet-title">Gửi Khoảnh Khắc Bé Cưng 🐾</h3>
        
        <form id="upload-photo-form">
          <!-- Bấm trực tiếp vào Polaroid frame để chọn ảnh -->
          <div class="polaroid-preview-area">
            <div id="preview-frame" class="polaroid-frame-preview interactive-preview" title="Nhấp vào đây để chọn ảnh bé cưng 🐾">
              <div id="preview-placeholder" class="photo-preview-placeholder">
                <i class="ph-light ph-camera" style="font-size: 2rem;"></i>
                <span style="font-size: 0.65rem; font-weight: 600; margin-top: 0.25rem;">Nhấp chọn ảnh bé...</span>
              </div>
              <img id="preview-img" class="hidden" alt="Preview ảnh bé cưng" />
              <!-- Watermark hiển thị động dạng @username từ email -->
              <span id="preview-watermark" class="photo-watermark hidden">@guest</span>
            </div>
          </div>

          <!-- Input file ẩn hoàn toàn, trigger qua JS khi click Polaroid frame -->
          <input type="file" id="photo-file" accept="image/*" style="display: none;" required />

          <div class="form-group-item">
            <label for="photo-email" class="form-label-custom">Email của bạn (Copyright ảnh)*</label>
            <input type="email" id="photo-email" class="form-text-input" placeholder="email_cua_ban@example.com" required />
          </div>

          <div class="form-group-item">
            <label for="photo-note" class="form-label-custom">Lời viết tay đằng sau ảnh*</label>
            <textarea id="photo-note" class="form-textarea-custom" placeholder="Ví dụ: Bé nằm ngoan ngủ khò bên bậu cửa nắng ấm..." maxlength="150" required></textarea>
            <div class="char-counter" id="char-counter">0/150</div>
          </div>



          <button type="submit" id="submit-photo-btn" class="submit-photo-btn">
            Gửi lên bức tường <i class="ph-light ph-paper-plane"></i>
          </button>
        </form>

        <div id="modal-status-msg" class="status-msg hidden">
          <span class="status-icon"><i class="ph-light ph-spinner-gap spin"></i></span>
          <span id="status-text" class="status-text">Đang chuẩn bị...</span>
        </div>
      </div>
    </div>

  </main>
</Layout>

<script>
  // Trích xuất EXIF metadata bằng exif-js
  function getExifMetadata(file: File): Promise<{ takenDate: string | null; takenLocation: string | null }> {
    return new Promise((resolve) => {
      const EXIF = (window as any).EXIF;
      if (!EXIF) {
        resolve({ takenDate: null, takenLocation: null });
        return;
      }
      
      EXIF.getData(file, async function(this: any) {
        const dateTime = EXIF.getTag(this, "DateTimeOriginal");
        let takenDate: string | null = null;
        if (dateTime) {
          // Định dạng EXIF DateTimeOriginal thường là "YYYY:MM:DD HH:MM:SS" -> Chuyển sang DD/MM/YYYY
          const datePart = dateTime.split(' ')[0];
          const parts = datePart.split(':');
          if (parts.length === 3) {
            takenDate = `${parts[2]}/${parts[1]}/${parts[0]}`;
          }
        }
        
        const lat = EXIF.getTag(this, "GPSLatitude");
        const lon = EXIF.getTag(this, "GPSLongitude");
        const latRef = EXIF.getTag(this, "GPSLatitudeRef");
        const lonRef = EXIF.getTag(this, "GPSLongitudeRef");
        
        let takenLocation: string | null = null;
        if (lat && lon) {
          // Chuyển đổi toạ độ DMS sang DD
          const latDec = convertDMSToDD(lat, latRef);
          const lonDec = convertDMSToDD(lon, lonRef);
          
          // Chỉ tiếp tục nếu toạ độ hợp lệ (khác 0 và không phải NaN)
          if (latDec !== 0 && lonDec !== 0 && !isNaN(latDec) && !isNaN(lonDec)) {
            try {
              const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latDec}&lon=${lonDec}&zoom=10&accept-language=vi`);
              if (res.ok) {
                const geoData = await res.json();
                takenLocation = geoData.address.city || geoData.address.state || geoData.address.town || null;
              }
            } catch (e) {
              console.warn("Reverse geocode failed:", e);
            }
          }
        }
        
        resolve({ takenDate, takenLocation });
      });
    });
  }

  function convertDMSToDD(dms: any, ref: string): number {
    if (!dms) return 0;
    
    // Nếu dms không phải là mảng (ví dụ exif-js trả về số thực trực tiếp)
    if (!Array.isArray(dms)) {
      const val = Number(dms);
      return isNaN(val) ? 0 : (ref === "S" || ref === "W" ? -val : val);
    }
    
    if (dms.length < 3) return 0;
    
    // DMS là mảng [độ, phút, giây]
    const getVal = (val: any) => {
      if (typeof val === 'object' && val.numerator !== undefined && val.denominator !== undefined) {
        return val.numerator / val.denominator;
      }
      return Number(val) || 0;
    };
    
    const degrees = getVal(dms[0]);
    const minutes = getVal(dms[1]);
    const seconds = getVal(dms[2]);
    
    let dd = degrees + minutes / 60 + seconds / 3600;
    if (isNaN(dd)) return 0;
    
    if (ref === "S" || ref === "W") {
      dd = -dd;
    }
    return dd;
  }

  // Định nghĩa các từ khóa thô tục để lọc offline
  const BAD_WORDS = ['cút', 'đm', 'đéo', 'vcl', 'clm', 'chửi', 'ngu', 'chó', 'fuck', 'shit', 'asshole', 'bitch', 'dâm', 'khùng', 'điên', 'đần', 'cac', 'cc', 'cl'];
  
  function checkTextSafety(text: string): boolean {
    const lower = text.toLowerCase();
    return !BAD_WORDS.some(word => lower.includes(word));
  }

  // Nén và crop ảnh bằng Canvas theo tỷ lệ tương ứng Google Photos trước khi gửi
  function compressImage(file: File, aspectRatio: string): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (event) => {
        const img = new Image();
        img.src = event.target?.result as string;
        img.onload = () => {
          const canvas = document.createElement('canvas');
          
          let targetWidth = 600;
          let targetHeight = 600;
          if (aspectRatio === '3/4') {
            targetHeight = 800;
          } else if (aspectRatio === '4/5') {
            targetHeight = 750;
          }
          
          canvas.width = targetWidth;
          canvas.height = targetHeight;
          
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            reject(new Error("Cannot get canvas context"));
            return;
          }
          
          // Tính toán crop center (fit: 'cover', position: 'center')
          const targetRatio = targetWidth / targetHeight;
          const sourceRatio = img.width / img.height;
          
          let sx = 0, sy = 0, sWidth = img.width, sHeight = img.height;
          
          if (sourceRatio > targetRatio) {
            // Ảnh nguồn ngang hơn ảnh đích -> Cắt bớt chiều ngang
            sWidth = img.height * targetRatio;
            sx = (img.width - sWidth) / 2;
          } else {
            // Ảnh nguồn dọc hơn ảnh đích -> Cắt bớt chiều cao
            sHeight = img.width / targetRatio;
            sy = (img.height - sHeight) / 2;
          }
          
          ctx.drawImage(img, sx, sy, sWidth, sHeight, 0, 0, targetWidth, targetHeight);
          
          // Nén chất lượng JPEG 0.7 (tương tự sharp quality: 70 trong bulk_import.js)
          const compressed = canvas.toDataURL('image/jpeg', 0.7);
          resolve(compressed);
        };
        img.onerror = (err) => reject(err);
      };
      reader.onerror = (err) => reject(err);
    });
  }

  // Kiểm duyệt bằng TensorFlow.js (MobileNet)
  async function checkIsCatImage(imgElement: HTMLImageElement): Promise<boolean> {
    try {
      const model = await (window as any).mobilenet.load();
      const predictions = await model.classify(imgElement);
      console.log("TensorFlow predictions:", predictions);
      
      const catKeywords = ['cat', 'kitten', 'tabby', 'persian cat', 'siamese cat', 'egyptian mau', 'feline', 'maltese cat', 'tiger cat', 'angora', 'lynx', 'tiger', 'leopard', 'cougar'];
      const isCat = predictions.some((pred: any) => {
        const name = pred.className.toLowerCase();
        return catKeywords.some(kw => name.includes(kw)) && pred.probability > 0.08; // 8% threshold
      });
      return isCat;
    } catch (err) {
      console.error("TF.js Error, bypass to true:", err);
      return true; // Fallback
    }
  }





  function escapeHtml(str: string): string {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  document.addEventListener('DOMContentLoaded', () => {
    // --- 1. MOBILE MENU TOGGLE ---
    const menuToggleBtn = document.getElementById('menu-toggle-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    const closeMobileMenu = () => {
      if (mobileMenu?.classList.contains('active')) {
        menuToggleBtn?.setAttribute('aria-expanded', 'false');
        menuToggleBtn?.classList.remove('active');
        mobileMenu?.classList.remove('active');
      }
    };

    menuToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
      menuToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menuToggleBtn.classList.toggle('active');
      mobileMenu?.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    });

    document.addEventListener('touchstart', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    }, { passive: true });

    window.addEventListener('scroll', () => {
      closeMobileMenu();
    }, { passive: true });

    // --- 2. POLAROID CARD FLIP & COMMENTS TRIGGER ---
    function setupCardFlip(card: HTMLElement) {
      card.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        // Bỏ qua lật ảnh nếu click vào form bình luận hoặc các phần tử trong bình luận
        if (
          target.closest('a') || 
          target.closest('button') || 
          target.closest('.comments-container') || 
          target.closest('input') || 
          target.closest('form')
        ) return;
        
        const inner = card.querySelector('.polaroid-card-inner');
        if (inner) {
          const isFlipped = inner.classList.contains('is-flipped');
          const cardId = card.getAttribute('data-id') || '';
          
          if (isFlipped) {
            inner.classList.remove('is-flipped');
            if (typeof (window as any).gtag === 'function') {
              (window as any).gtag('event', 'flip_photo_card', { photo_id: cardId, state: 'unflipped' });
            }
          } else {
            const otherFlipped = document.querySelectorAll('.polaroid-card-inner.is-flipped');
            
            if (typeof (window as any).gtag === 'function') {
              (window as any).gtag('event', 'flip_photo_card', { photo_id: cardId, state: 'flipped' });
            }
            
            if (otherFlipped.length > 0) {
              otherFlipped.forEach(flippedInner => {
                flippedInner.classList.remove('is-flipped');
              });
              
              setTimeout(() => {
                inner.classList.add('is-flipped');
              }, 150);
            } else {
              inner.classList.add('is-flipped');
            }
          }
        }
      });
    }

    // Thiết lập cho 10 card tĩnh ban đầu
    document.querySelectorAll('.polaroid-card').forEach(card => {
      setupCardFlip(card as HTMLElement);
    });

    // --- 2.5 MASONRY FLEXBOX LAYOUT (Sắp xếp theo hàng ngang từ trái sang) ---
    function layoutMasonry() {
      const grid = document.getElementById('family-masonry-grid');
      if (!grid) return;

      const width = window.innerWidth;
      let colCount = 6;       // Desktop rộng 6 cột
      if (width < 640) colCount = 2;       // Mobile 2 cột
      else if (width < 1024) colCount = 3;  // Tablet 3 cột
      else if (width < 1280) colCount = 4;  // Desktop vừa 4 cột

      // Chỉ lấy các card và skeleton đang hiển thị để sắp xếp vào cột
      const visibleCards = Array.from(grid.querySelectorAll('.polaroid-card:not(.hidden-card), .polaroid-skeleton:not(.hidden-card)')) as HTMLElement[];
      const hiddenCards = Array.from(grid.querySelectorAll('.polaroid-card.hidden-card, .polaroid-skeleton.hidden-card')) as HTMLElement[];

      grid.innerHTML = '';

      const colElements: HTMLElement[] = [];
      for (let i = 0; i < colCount; i++) {
        const col = document.createElement('div');
        col.className = 'masonry-col';
        grid.appendChild(col);
        colElements.push(col);
      }

      visibleCards.forEach((card, index) => {
        const colIndex = index % colCount;
        colElements[colIndex].appendChild(card);
      });

      // Lưu lại các card đang ẩn ở gốc container để nút "Xem thêm" có thể tìm thấy và hiển thị tiếp
      hiddenCards.forEach(card => {
        grid.appendChild(card);
      });
    }

    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        layoutMasonry();
      }, 150);
    });

    // Hàm rút gọn địa danh cho ngắn và đậm chất hoài niệm (Ví dụ: TP. Hồ Chí Minh -> Sài Gòn, Thừa Thiên Huế -> Huế)
    function simplifyLocation(loc: string | null): string {
      if (!loc) return '';
      let clean = loc.trim();
      
      // Loại bỏ các tiền tố hành chính phổ biến
      clean = clean.replace(/^(Thành phố|Tỉnh|Huyện|Quận)\s+/gi, '');
      
      const lower = clean.toLowerCase();
      if (lower.includes('hồ chí minh') || lower.includes('hcm')) {
        return 'Sài Gòn';
      }
      if (lower.includes('thừa thiên huế') || lower === 'huế') {
        return 'Huế';
      }
      if (lower.includes('phan rang')) {
        return 'Phan Rang';
      }
      if (lower.includes('đà lạt')) {
        return 'Đà Lạt';
      }
      if (lower.includes('hà nội')) {
        return 'Hà Nội';
      }
      if (lower.includes('đà nẵng')) {
        return 'Đà Nẵng';
      }
      if (lower.includes('nha trang')) {
        return 'Nha Trang';
      }
      if (lower.includes('vũng tàu')) {
        return 'Vũng Tàu';
      }
      if (lower.includes('cần thơ')) {
        return 'Cần Thơ';
      }
      if (lower.includes('hải phòng')) {
        return 'Hải Phòng';
      }
      
      return clean;
    }

    // --- 3. FETCH AND DISPLAY GUEST CONTRIBUTIONS FROM SUPABASE ---
    async function loadGuestPhotos() {
      const url = (window as any).PUBLIC_SUPABASE_URL;
      const key = (window as any).PUBLIC_SUPABASE_ANON_KEY;
      if (!url || !key) return;

      const grid = document.getElementById('family-masonry-grid');
      if (!grid) return;

      // A. Tạo và chèn 12 Polaroid Skeleton tối giản tạm thời (2 hàng trên layout 6 cột)
      const skeletons: HTMLElement[] = [];
      for (let i = 0; i < 12; i++) {
        const skeleton = document.createElement('div');
        skeleton.className = 'polaroid-skeleton';
        const randomRatio = i % 3 === 0 ? '3/4' : (i % 3 === 1 ? '4/5' : '1/1');
        skeleton.style.aspectRatio = randomRatio;
        
        grid.appendChild(skeleton);
        skeletons.push(skeleton);
      }
      
      // Sắp xếp lại lưới Masonry để phân cột cho các Skeleton
      layoutMasonry();

      try {
        const res = await fetch(`${url}/rest/v1/family_contributions?status=eq.approved&order=created_at.desc`, {
          headers: {
            'apikey': key,
            'Authorization': `Bearer ${key}`
          }
        });
        
        // B. Xóa bỏ các Skeleton sau khi hoàn tất tải dữ liệu
        skeletons.forEach(s => s.remove());

        if (res.ok) {
          const contributions = await res.json();
          
          contributions.forEach((photo: any, index: number) => {
            // Tạo thẻ Polaroid
            const card = document.createElement('div');
            // 12 tấm ảnh đầu tiên sẽ hiển thị ngay lập tức (2 hàng của layout 6 cột), còn lại ẩn đi
            const shouldHide = index >= 12;
            card.className = `polaroid-card guest-contribution ${shouldHide ? 'hidden-card' : ''}`;
            card.setAttribute('data-id', photo.id.toString());
            card.setAttribute('data-type', 'contribution');

            // Trích xuất copyright name từ email tác giả
            const authorEmail = photo.author_name || 'guest';
            const copyrightName = authorEmail.includes('@') ? authorEmail.split('@')[0] : authorEmail;

            // Định dạng ngày chụp & địa điểm hiển thị ở mặt sau (EXIF metadata)
            const dateStr = photo.taken_at || (photo.created_at ? new Date(photo.created_at).toLocaleDateString('vi-VN') : '');
            const rawLocation = photo.taken_location || '';
            const cleanLocation = simplifyLocation(rawLocation);

            const safeLocation = escapeHtml(cleanLocation);
            const safeDate = escapeHtml(dateStr);

            // Định dạng: "Sài Gòn • 18/06/2026"
            let footerText = '';
            if (safeLocation && safeDate) {
              footerText = `${safeLocation} &nbsp;•&nbsp; ${safeDate}`;
            } else if (safeLocation) {
              footerText = safeLocation;
            } else if (safeDate) {
              footerText = safeDate;
            } else {
              footerText = '#guest_pet';
            }

            // Dựng template HTML Polaroid
            card.innerHTML = `
              <div class="polaroid-card-inner">
                <div class="card-front">
                  <div class="polaroid-frame">
                    <div class="photo-wrapper" style="aspect-ratio: ${photo.aspect_ratio || '1/1'};">
                      <img src="${photo.image_url}" alt="${escapeHtml(photo.title)}" class="polaroid-photo" loading="lazy" />
                      <span class="photo-watermark">@${escapeHtml(copyrightName)}</span>
                    </div>
                  </div>
                </div>
                <div class="card-back">
                  <div class="note-paper">
                    <div class="note-content-wrapper">
                      ${photo.note ? `<p class="note-monospace">${escapeHtml(photo.note)}</p>` : ''}

                      <div class="note-footer">
                        <span class="note-tag">${footerText}</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            `;

            grid.appendChild(card);
            setupCardFlip(card);
          });
          
          // Cập nhật lại hidden cards
          updateLoadMoreButtonState();
          
          // Chia cột và phân phối layout Masonry từ trái sang phải
          layoutMasonry();
        }
      } catch (err) {
        console.error("Load contributions error:", err);
        // Xóa bỏ các Skeleton nếu gặp lỗi
        skeletons.forEach(s => s.remove());
        layoutMasonry();
      }
    }

    loadGuestPhotos();

    // --- 4. LOAD MORE (Xem thêm mỗi lần 10 hình) ---
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
    
    function updateLoadMoreButtonState() {
      const hiddenCards = document.querySelectorAll('.polaroid-card.hidden-card');
      if (hiddenCards.length === 0 && loadMoreBtn) {
        loadMoreBtn.classList.add('disabled');
        loadMoreBtn.innerHTML = 'Bạn đã xem hết khoảnh khắc rồi 🐾';
        loadMoreBtn.setAttribute('disabled', 'true');
      } else if (loadMoreBtn) {
        loadMoreBtn.classList.remove('disabled');
        loadMoreBtn.innerHTML = 'Xem thêm khoảnh khắc <i class="ph-light ph-caret-down"></i>';
        loadMoreBtn.removeAttribute('disabled');
      }
    }

    loadMoreBtn?.addEventListener('click', () => {
      const hiddenCards = document.querySelectorAll('.polaroid-card.hidden-card');
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'click_load_more_moments');
      }
      
      const nextBatch = Array.from(hiddenCards).slice(0, 12);
      nextBatch.forEach(card => {
        card.classList.remove('hidden-card');
      });
      
      updateLoadMoreButtonState();
      layoutMasonry(); // Sắp xếp lại lưới khi có thêm hình mới hiển thị
    });

    // --- 5. MODAL FOR UPLOADING PHOTO ---
    const modal = document.getElementById('upload-photo-modal') as HTMLDivElement;
    const triggerBtn = document.getElementById('upload-photo-trigger') as HTMLButtonElement;
    const closeBtn = document.getElementById('modal-close-btn') as HTMLButtonElement;
    const form = document.getElementById('upload-photo-form') as HTMLFormElement;
    const fileInput = document.getElementById('photo-file') as HTMLInputElement;
    const emailInput = document.getElementById('photo-email') as HTMLInputElement;
    const noteInput = document.getElementById('photo-note') as HTMLTextAreaElement;
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const previewPlaceholder = document.getElementById('preview-placeholder') as HTMLDivElement;
    const previewWatermark = document.getElementById('preview-watermark');
    const previewFrame = document.getElementById('preview-frame');
    const statusMsg = document.getElementById('modal-status-msg') as HTMLDivElement;
    const statusText = document.getElementById('status-text') as HTMLSpanElement;
    const submitBtn = document.getElementById('submit-photo-btn') as HTMLButtonElement;

    // Click vào Polaroid preview để chọn ảnh
    previewFrame?.addEventListener('click', () => {
      fileInput.click();
    });

    // Cập nhật watermark copyright dạng @username thời gian thực
    emailInput?.addEventListener('input', () => {
      const email = emailInput.value.trim();
      if (email) {
        const username = email.split('@')[0] || 'guest';
        if (previewWatermark) {
          previewWatermark.textContent = `@${username}`;
          previewWatermark.classList.remove('hidden');
        }
      } else {
        if (previewWatermark) {
          previewWatermark.classList.add('hidden');
        }
      }
    });

    // Show/Hide modal
    triggerBtn?.addEventListener('click', () => {
      modal.classList.add('open');
    });

    const hideModal = () => {
      modal.classList.remove('open');
      form.reset();
      previewImg.classList.add('hidden');
      previewPlaceholder.classList.remove('hidden');
      if (previewWatermark) {
        previewWatermark.classList.add('hidden');
        previewWatermark.textContent = '@guest';
      }
      statusMsg.classList.add('hidden');
      submitBtn.disabled = false;
    };

    closeBtn?.addEventListener('click', hideModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });

    // File Preview & Auto Ratio & EXIF calculation
    let currentFile: File | null = null;
    let computedAspectRatio = '1/1';
    let computedTakenAt: string | null = null;
    let computedTakenLocation: string | null = null;

    fileInput?.addEventListener('change', (e) => {
      const files = fileInput.files;
      if (!files || files.length === 0) return;
      
      currentFile = files[0];
      
      // Trích xuất EXIF metadata từ hình ảnh
      computedTakenAt = null;
      computedTakenLocation = null;
      getExifMetadata(currentFile).then(meta => {
        computedTakenAt = meta.takenDate;
        computedTakenLocation = meta.takenLocation;
        console.log("Trích xuất EXIF thành công:", meta);
      });

      const reader = new FileReader();
      reader.onload = (event) => {
        if (previewImg && previewPlaceholder) {
          previewImg.src = event.target?.result as string;
          previewImg.classList.remove('hidden');
          previewPlaceholder.classList.add('hidden');
          
          // Show watermark khi đã load ảnh lên
          const email = emailInput.value.trim();
          const username = email ? (email.split('@')[0] || 'guest') : 'guest';
          if (previewWatermark) {
            previewWatermark.textContent = `@${username}`;
            previewWatermark.classList.remove('hidden');
          }
          
          // Tính toán aspect ratio tương tự bulk_import.js (Google Photos alignment)
          const img = new Image();
          img.src = event.target?.result as string;
          img.onload = () => {
            const ratio = img.width / img.height;
            if (ratio > 1.05) {
              // Ảnh ngang -> Crop về 1:1
              computedAspectRatio = '1/1';
            } else if (ratio < 0.95) {
              // Ảnh dọc -> Chọn ngẫu nhiên 3:4 hoặc 4:5
              computedAspectRatio = Math.random() < 0.5 ? '3/4' : '4/5';
            } else {
              // Ảnh vuông
              computedAspectRatio = '1/1';
            }
            if (previewFrame) {
              previewFrame.style.aspectRatio = computedAspectRatio;
            }
          };
        }
      };
      reader.readAsDataURL(currentFile);
    });

    // Hàm lưu đóng góp lên Supabase với trạng thái enum và metadata chụp ảnh
    async function saveContributionToSupabase(
      title: string,
      base64Data: string,
      note: string,
      author: string,
      aspectRatio: string,
      status: 'approved' | 'rejected' | 'pending',
      takenAt: string | null = null,
      takenLocation: string | null = null
    ): Promise<boolean> {
      const url = (window as any).PUBLIC_SUPABASE_URL;
      const key = (window as any).PUBLIC_SUPABASE_ANON_KEY;
      if (!url || !key) {
        console.warn("Supabase credentials missing. Simulated submit success.");
        return true;
      }
      
      try {
        const res = await fetch(`${url}/rest/v1/family_contributions`, {
          method: 'POST',
          headers: {
            'apikey': key,
            'Authorization': `Bearer ${key}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            title: title,
            image_url: base64Data,
            note: note,
            author_name: author,
            aspect_ratio: aspectRatio,
            status: status,
            taken_at: takenAt,
            taken_location: takenLocation
          })
        });
        
        if (!res.ok) {
          const errText = await res.text();
          console.error("Supabase save failed. Status:", res.status, "Details:", errText);
        }
        
        return res.ok;
      } catch (e) {
        console.error("Supabase save error:", e);
        return false;
      }
    }

    // Submit form với kiểm duyệt ngầm (Background moderation & instant close)
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // 1. Thu thập dữ liệu form trước khi đóng và reset
      const fileToSend = currentFile;
      const email = emailInput.value.trim();
      const note = noteInput.value.trim();
      
      // 2. Đóng Bottom Sheet ngay lập tức
      hideModal();
      
      // Reset counter ký tự về 0
      const charCounter = document.getElementById('char-counter');
      if (charCounter) charCounter.textContent = '0/150';
      
      // 3. Thông báo đang xử lý ngầm qua Toast toàn cục
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast("Đang tải lên và kiểm duyệt ngầm khoảnh khắc bé cưng... 🐾");
      }
      
      // 4. Chạy tiến trình xử lý ngầm (Background Task)
      (async () => {
        try {
          // A. Kiểm tra nhanh ở background
          if (!fileToSend) {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast("Lỗi gửi ảnh: Vui lòng chọn một bức ảnh bằng cách nhấp vào khung Polaroid! 🐾");
            }
            return;
          }

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast("Lỗi gửi ảnh: Email không hợp lệ. Cô/chú kiểm tra lại nhé! 🐾");
            }
            return;
          }

          // B. Nén và crop ảnh theo tỷ lệ tương thích Google Photos
          const compressedBase64 = await compressImage(fileToSend, computedAspectRatio);
          const title = "Khoảnh khắc dễ thương";
          const author = email;
          
          // C. Kiểm duyệt nội dung viết tay (Offline filter)
          if (!checkTextSafety(email) || !checkTextSafety(note)) {
            // Lưu vi phạm vào Supabase dạng 'rejected'
            await saveContributionToSupabase(title, compressedBase64, note, author, computedAspectRatio, 'rejected', computedTakenAt, computedTakenLocation);
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast("Khoảnh khắc bị từ chối: Lời viết tay hoặc email chứa từ ngữ chưa lành mạnh. 🐾");
            }
            return;
          }

          // D. Kiểm duyệt hình ảnh bằng Cloudflare Workers AI thông qua API ngoại vi
          let finalStatus: 'approved' | 'rejected' | 'pending' = 'pending';
          let rejectReason = '';
          
          // Lấy URL từ biến môi trường của Astro được gán tại build-time hoặc client-side window
          const cloudflareWorkerUrl = (window as any).PUBLIC_CLOUDFLARE_MODERATION_URL || import.meta.env.PUBLIC_CLOUDFLARE_MODERATION_URL;
          
          if (cloudflareWorkerUrl) {
            try {
              const response = await fetch(cloudflareWorkerUrl, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  image: compressedBase64
                })
              });
              
              if (response.ok) {
                const result = await response.json() as { valid: boolean, reason: string };
                if (result.valid) {
                  finalStatus = 'approved';
                } else {
                  finalStatus = 'rejected';
                  rejectReason = result.reason || "Hình ảnh không được phê duyệt.";
                }
              } else {
                console.warn("Cloudflare Worker returned non-OK response, fallback to pending.");
                finalStatus = 'pending';
              }
            } catch (cfErr) {
              console.error("Cloudflare Worker request failed, fallback to pending:", cfErr);
              finalStatus = 'pending';
            }
          } else {
            console.warn("PUBLIC_CLOUDFLARE_MODERATION_URL is missing. Fallback to pending.");
            finalStatus = 'pending';
          }

          // E. Gửi lên database
          const success = await saveContributionToSupabase(title, compressedBase64, note, author, computedAspectRatio, finalStatus, computedTakenAt, computedTakenLocation);
          
          if (success) {
            if (finalStatus === 'approved') {
              if (typeof (window as any).showToast === 'function') {
                (window as any).showToast("Đăng khoảnh khắc thành công! Đang tải lại bức tường... 🎉");
              }
              setTimeout(() => {
                window.location.reload();
              }, 1500);
            } else if (finalStatus === 'rejected') {
              if (typeof (window as any).showToast === 'function') {
                (window as any).showToast(`Khoảnh khắc không được phê duyệt: ${rejectReason || 'Không hợp lệ.'} 🐾`);
              }
            } else {
              // pending
              if (typeof (window as any).showToast === 'function') {
                (window as any).showToast("Gửi khoảnh khắc thành công! Hình ảnh đang chờ Admin duyệt nha cô/chú! 🐾");
              }
            }
          } else {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast("Có lỗi xảy ra khi lưu trữ ảnh lên hệ thống. Vui lòng thử lại! 🐾");
            }
          }

        } catch (error) {
          console.error("Background task failed:", error);
          // Trường hợp lỗi bất khả kháng, lưu dưới dạng pending để admin duyệt
          try {
            await saveContributionToSupabase("Khoảnh khắc dễ thương", compressedBase64 || "", note, email, computedAspectRatio, 'pending', computedTakenAt, computedTakenLocation);
          } catch (e) {}
          
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast("Gửi khoảnh khắc thành công! Đang chờ Admin duyệt thủ công nhé cô/chú! 🐾");
          }
        }
      })();
    });
  });
</script>

