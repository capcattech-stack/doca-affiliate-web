  products = STATIC_PRODUCTS_FALLBACK;
}

// 3. Chọn ra đúng 8 sản phẩm nổi bật có ảnh đầy đủ để trưng bày ở trang chủ
const FEATURED_SLUGS = [
  'khan-tam-sieu-hut-nuoc-cho-meo-mastercare',
  'hat-cho-meo-mr-vet-1kg',
  'pate-meo-moi-lua-tuoi-catchy-400g',
  'pate-sua-de-bite-of-wild-bich-70g-cho-meo-tu-2-thang-tuoi',
  'hat-cho-meo-con-bite-of-wild-1kg',
  'hat-dinh-duong-huu-co',
  'luoc-massage-tao-bot',
  'sach-tam-ly-meo'
];

let featuredProducts: any[] = FEATURED_SLUGS.map(slug => {
  return products.find(p => p.slug === slug);
}).filter(Boolean);

if (featuredProducts.length < 8) {
  const remaining = products.filter(p => !featuredProducts.some(fp => fp.slug === p.slug));
  featuredProducts = [...featuredProducts, ...remaining].slice(0, 8);
}

// Hàm format danh mục sản phẩm của Supabase sang nhãn hiển thị hoặc nhãn Pillar nếu có
const getCategoryLabel = (cat: string, pil?: string) => {
  if (pil) {
    const pillarLabels: Record<string, string> = {
      'nhip_tho': 'Nhịp Thở Đồng Diệu',
      'lang_kinh': 'Lăng Kính Của Pet',
      'hop_ky_uc': 'Hộp Ký Ức Bình Yên'
    };
    return pillarLabels[pil] || cat;
  }
  const labels: Record<string, string> = {
    'thuc_an': 'Thức Ăn Mèo',
    'vat_pham': 'Vật Phẩm Chăm Sóc',
    'sach': 'Sách Chữa Lành',
    'phu_kien': 'Phụ Kiện Nhà Ở'
  };
  return labels[cat] || cat;
};
