    position: relative;
    flex-shrink: 0;
    margin-left: 0px !important; /* Dời đĩa than sát lề trái để padding bằng đúng lề top/bottom (8px) */
    animation: spinMiniVinyl 8s linear infinite;
    animation-play-state: paused;
  }

  .cozy-mini-player-float.playing .mini-player-vinyl {
    animation-play-state: running;
  }

  @keyframes spinMiniVinyl {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .mini-vinyl-center {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--cozy-bg-oatmeal);
    border: 1px solid #111;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Căn lề trái thông tin bài hát */
  .mini-player-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start !important; /* Căn lề trái */
    justify-content: center;
    text-align: left !important; /* Căn lề trái */
    min-width: 0;
    padding: 0 0.5rem;
    margin-left: 14px !important; /* Khoảng cách an toàn ngăn đè chữ lên đĩa than */
    flex: 1; /* Tự động dãn chiếm hết khoảng giữa */
  }

  .mini-track-title-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start !important; /* Căn lề trái */
    gap: 0.35rem;
    max-width: 100%;
    min-width: 0;
  }

  .mini-track-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 750;
    color: var(--cozy-text-obsidian);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  /* Sóng nhạc mini (Equalizer mini) cho Float Mini Player */
  .mini-wave-indicator {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    width: 12px;
    height: 10px;
    flex-shrink: 0;
  }

  .mini-wave-bar {
    width: 2.2px;
    height: 100%;
    background-color: var(--cozy-green-matcha-forest);
    border-radius: 1px;
    animation: miniWaveAnimate 1.2s ease-in-out infinite alternate;
    transform-origin: bottom;
  }

  .mini-wave-bar:nth-child(1) { animation-delay: 0.15s; }
  .mini-wave-bar:nth-child(2) { animation-delay: 0.35s; }
  .mini-wave-bar:nth-child(3) { animation-delay: 0.55s; }

  @keyframes miniWaveAnimate {
    0% { transform: scaleY(0.25); }
    100% { transform: scaleY(1); }
  }

  /* Thanh tiến trình mini ở trên cùng */
  .mini-player-progress-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: rgba(139, 94, 60, 0.08);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    overflow: hidden;
    z-index: 10;
  }

  .mini-player-progress-bar {
    width: 0%;
    height: 100%;
    background-color: var(--cozy-green-matcha-forest);
    transition: width 0.1s linear;
  }

  .mini-track-artist {
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    color: #8E8E93;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
    text-align: left !important; /* Căn lề trái */
  }

  /* Ẩn các nút phụ, chỉ giữ nút Play/Pause tròn Matcha ở cột 3 */
  .mini-player-controls {
    display: flex;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-right: 0px !important; /* Lề phải bằng đúng lề trái (8px) */
  }

  #mini-btn-prev, #mini-btn-next {
    display: none !important;
  }

  .mini-play-btn {
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    border: none !important;
    background-color: var(--cozy-green-matcha-forest) !important;
    color: #fff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1rem !important;
    box-shadow: 0 2px 6px rgba(74, 138, 46, 0.15) !important;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mini-play-btn:hover {
    background-color: var(--cozy-wood-sugi) !important;
    transform: scale(1.05);
  }

  .mini-play-btn.hidden {
    display: none !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- 1. MOBILE MENU TOGGLE ---
    const menuToggleBtn = document.getElementById('menu-toggle-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    const closeMobileMenu = () => {
      if (mobileMenu?.classList.contains('active')) {
        menuToggleBtn?.setAttribute('aria-expanded', 'false');
        menuToggleBtn?.classList.remove('active');
        mobileMenu?.classList.remove('active');
      }
    };

    menuToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
      menuToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menuToggleBtn.classList.toggle('active');
      mobileMenu?.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    });

    document.addEventListener('touchstart', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    }, { passive: true });

    window.addEventListener('scroll', () => {
      closeMobileMenu();
    }, { passive: true });

    // --- 2. COZY MUSIC PLAYER LOGIC ---
    const audio = document.getElementById('lounge-audio-player') as HTMLAudioElement;
    const playPauseBtn = document.getElementById('btn-play-pause');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const btnNext = document.getElementById('btn-next');
    const btnPrev = document.getElementById('btn-prev');
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;

    const trackTitleDisplay = document.getElementById('player-track-title');
    const trackArtistDisplay = document.getElementById('player-track-artist');
    const timeCurrent = document.getElementById('time-current');
    const timeTotal = document.getElementById('time-total');
    const progressBar = document.getElementById('progress-bar');
    const progressHandle = document.getElementById('progress-handle');
    const progressBarWrapper = document.getElementById('progress-bar-wrapper');

    const vinylDisc = document.getElementById('vinyl-disc');
    const vinylArm = document.getElementById('vinyl-arm');

    const playlistsContainer = document.getElementById('playlists-container');
    const tracksListContainer = document.getElementById('tracks-list-container');

    // Float Mini Player DOM elements
    const miniPlayer = document.getElementById('cozy-mini-player');
    const miniPlayIcon = document.getElementById('mini-play-icon');
    const miniPauseIcon = document.getElementById('mini-pause-icon');
    const miniTrackTitle = document.getElementById('mini-track-title');
    const miniTrackArtist = document.getElementById('mini-track-artist');
    const miniBtnPlayPause = document.getElementById('mini-btn-play-pause');
    const miniBtnNext = document.getElementById('mini-btn-next');
    const miniBtnPrev = document.getElementById('mini-btn-prev');
    const miniPlayerWave = document.getElementById('mini-player-wave');
    const miniProgressBar = document.getElementById('mini-player-progress-bar');

    let allTracks: any[] = [];
    let groupedPlaylists: Record<string, any> = {};
    let activePlaylistKey = 'tina_tuyen_chon';
    let activeTrackIndex = 0;
    let isPlaying = false;

    // Định dạng giây thành mm:ss
    function formatTime(seconds: number) {
      if (isNaN(seconds)) return '0:00';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    // Giao diện tên Playlist đẹp hơn
    function formatPlaylistName(key: string) {
      const names: Record<string, string> = {
        'tina_tuyen_chon': 'Tina Tuyển Chọn 🐾',
        'morning': 'Nắng Sớm Bên Hiên ☕',
        'afternoon': 'Góc Chiều Bình Yên 🍃',
        'evening': 'Đèn Vàng Vĩ Tuyến 🌙',
        'jazz': 'Cà Phê & Jazz Sớm 🎷',
        'rainy': 'Bản Nhạc Mưa Đêm ☔'
      };
      if (names[key]) return names[key];
      return key; // Giữ nguyên tên thư mục gốc trên R2 vì nó đã rất đẹp và rõ nghĩa
    }

    // Tải thông tin playlist từ R2
    async function loadPlaylistData() {
      const r2Domain = (window as any).PUBLIC_R2_PUBLIC_DOMAIN || 'https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev';
      const playlistUrl = `${r2Domain.replace(/\/$/, '')}/playlist.json`;
      
      try {
        // 1. Thử tải từ đường dẫn tương đối gốc /playlist.json trước (Tránh CORS trên cả Local và Prod)
        let res = await fetch('/playlist.json');
        if (!res.ok) throw new Error("Không thể nạp playlist tương đối");
        const data = await res.json();
        console.log("Successfully loaded playlist.json from relative path in music.astro");
        
        allTracks = data.tracks || [];
        processGroupedPlaylists();
        renderPlaylists();
        
        const keys = Object.keys(groupedPlaylists);
        if (keys.length > 0) {
          selectPlaylist(keys[0]);
        }
      } catch (relativeErr) {
        console.warn("Lỗi nạp nhạc tương đối, thử nạp trực tiếp R2 CDN:", relativeErr);
        try {
          let res = await fetch(playlistUrl);
          if (!res.ok) throw new Error("Không thể nạp playlist trực tiếp");
          const data = await res.json();
          
          allTracks = data.tracks || [];
          processGroupedPlaylists();
          renderPlaylists();
          
          const keys = Object.keys(groupedPlaylists);
          if (keys.length > 0) {
            selectPlaylist(keys[0]);
          }
        } catch (err) {
          console.warn("Lỗi nạp nhạc R2 trực tiếp, thử qua CORS proxy:", err);
          try {
            const proxyUrl = `https://corsproxy.io/?${encodeURIComponent(playlistUrl)}`;
            const proxyRes = await fetch(proxyUrl);
            if (!proxyRes.ok) throw new Error("Không thể nạp qua CORS proxy");
            const data = await proxyRes.json();
            
            allTracks = data.tracks || [];
            processGroupedPlaylists();
            renderPlaylists();
            
            const keys = Object.keys(groupedPlaylists);
            if (keys.length > 0) {
              selectPlaylist(keys[0]);
            }
          } catch (proxyErr) {
            console.error("Cả fetch trực tiếp và CORS proxy đều lỗi, chuyển sang offline fallback:", proxyErr);
            // Fallback offline với nhạc MP3 cực kì sạch sẽ của chính dự án từ R2 CDN
            allTracks = [
              { id: "fallback_01", title: "New Day Waltz ☕", artist: "Tina's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/Morning%20Tea%20%26%20Cake%20%E2%98%95%201940s%20Vintage%20Cafe%20Ambience%20%E2%80%93%20A%20Sweet%20%26%20Peaceful%20Corner%20for%20You/New%20Day%20Waltz.mp3", duration: 194 },
              { id: "fallback_02", title: "Cozy Garden 🌿", artist: "Latte's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/Morning%20Tea%20%26%20Cake%20%E2%98%95%201940s%20Vintage%20Cafe%20Ambience%20%E2%80%93%20A%20Sweet%20%26%20Peaceful%20Corner%20for%20You/Cozy%20Garden.mp3", duration: 180 },
              { id: "fallback_03", title: "My Late Night Monologue 🌙", artist: "Muối's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/1940s%20VINTAGE%20CAFE%20AMBIENCE%20-%20A%20LITTLE%20CALM%20FOR%20YOU%20TODAY/My%20Late%20Night%20Monologue.mp3", duration: 217 }
            ];
            processGroupedPlaylists();
            renderPlaylists();
            selectPlaylist('tina_tuyen_chon');
          }
        }
      }
    }

    // Phân nhóm bài hát theo thư mục
    function processGroupedPlaylists() {
      groupedPlaylists = {
        'tina_tuyen_chon': {
          name: 'Tina Tuyển Chọn 🐾',
          icon: 'ph-star-of-life',
          tracks: []
        }
      };

      allTracks.forEach(track => {
        const urlPath = track.url || "";
        const match = urlPath.match(/tracks\/([^\/]+)\//);
        
        if (match && match[1]) {
          const folderKey = decodeURIComponent(match[1]);
          if (!groupedPlaylists[folderKey]) {
            groupedPlaylists[folderKey] = {
              name: formatPlaylistName(folderKey),
              icon: getPlaylistIcon(folderKey),
              tracks: []
            };
          }
          groupedPlaylists[folderKey].tracks.push(track);
        } else {
          groupedPlaylists['tina_tuyen_chon'].tracks.push(track);
        }
      });

      // Xóa playlist 'tina_tuyen_chon' nếu rỗng
      if (groupedPlaylists['tina_tuyen_chon'].tracks.length === 0) {
        delete groupedPlaylists['tina_tuyen_chon'];
      }
    }

    function getPlaylistIcon(key: string) {
      const lower = key.toLowerCase();
      if (lower.includes('jazz')) return 'ph-music-notes-simple';
      if (lower.includes('rain') || lower.includes('mưa')) return 'ph-cloud-rain';
      if (lower.includes('morning') || lower.includes('sáng')) return 'ph-sun-dim';
      if (lower.includes('evening') || lower.includes('tối') || lower.includes('night')) return 'ph-moon';
      if (lower.includes('chill') || lower.includes('healing')) return 'ph-heartbeat';
      return 'ph-disc';
    }

    let currentAlbumPage = 1;
    const albumsPerPage = 6;

    // Render danh sách Playlists (Album đĩa than)
    function renderPlaylists() {
      if (!playlistsContainer) return;
      playlistsContainer.innerHTML = '';

      const keys = Object.keys(groupedPlaylists);
      const totalAlbums = keys.length;
      
      // Trên desktop, áp dụng phân trang nếu có nhiều hơn 6 album
      const isDesktop = window.innerWidth >= 1024;
      let keysToShow = keys;

      if (isDesktop && totalAlbums > albumsPerPage) {
        const start = (currentAlbumPage - 1) * albumsPerPage;
        const end = start + albumsPerPage;
        keysToShow = keys.slice(start, end);
      }

      keysToShow.forEach(key => {
        const pl = groupedPlaylists[key];
        
        // Tạo container cho mỗi Album đĩa than
        const card = document.createElement('div');
        card.className = `playlist-vinyl-item ${key === activePlaylistKey ? 'active' : ''} ${key === activePlaylistKey && isPlaying ? 'playing' : ''}`;
        card.setAttribute('data-key', key);

        card.innerHTML = `
          <div class="playlist-vinyl-active-dot"></div>
          <div class="vinyl-jacket-container">
            <!-- Bao đĩa than (Jacket) -->
            <div class="vinyl-jacket">
              <div class="jacket-art-center"></div>
              <i class="ph-light ${pl.icon || 'ph-disc'} jacket-icon"></i>
            </div>
            <!-- Đĩa than đen (Vinyl Disc Media) -->
            <div class="vinyl-disc-media">
              <div class="vinyl-grooves"></div>
              <div class="vinyl-center-label">
                <div class="vinyl-label-hole"></div>
              </div>
            </div>
          </div>
          <div class="playlist-vinyl-info">
            <h4 class="playlist-vinyl-title">${pl.name}</h4>
            <span class="playlist-vinyl-count">${pl.tracks.length} bài hát</span>
          </div>
        `;

        card.addEventListener('click', () => {
          selectPlaylist(key);
        });

        playlistsContainer.appendChild(card);
      });

      // Tạo thanh phân trang album
      renderAlbumPagination(totalAlbums);
    }

    // Tạo thanh phân trang Album trên Desktop
    function renderAlbumPagination(totalAlbums: number) {
      let paginationContainer = document.getElementById('playlists-pagination');
      const isDesktop = window.innerWidth >= 1024;

      if (!isDesktop || totalAlbums <= albumsPerPage) {
        if (paginationContainer) paginationContainer.style.display = 'none';
        return;
      }

      if (!paginationContainer) {
        paginationContainer = document.createElement('div');
        paginationContainer.id = 'playlists-pagination';
        paginationContainer.className = 'playlists-pagination-container';
        playlistsContainer.parentNode?.insertBefore(paginationContainer, playlistsContainer.nextSibling);
      }

      paginationContainer.style.display = 'flex';
      paginationContainer.innerHTML = '';

      const totalPages = Math.ceil(totalAlbums / albumsPerPage);

      // Đảm bảo trang hiện tại không vượt quá tổng số trang mới
      if (currentAlbumPage > totalPages) {
        currentAlbumPage = totalPages;
      }

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.className = `album-page-btn ${i === currentAlbumPage ? 'active' : ''}`;
        btn.textContent = i.toString();
        btn.addEventListener('click', () => {
          currentAlbumPage = i;
          renderPlaylists();
        });
        paginationContainer.appendChild(btn);
      }
    }

    // Chọn Playlist
    function selectPlaylist(key: string) {
      activePlaylistKey = key;
      activeTrackIndex = 0;
      
      const pl = groupedPlaylists[key];
      const badge = document.getElementById('active-album-title-badge');
      if (badge && pl) {
        badge.textContent = `• ${pl.name}`;
      }
      
      // Cập nhật trạng thái active UI đĩa than
      const cards = document.querySelectorAll('.playlist-vinyl-item');
      cards.forEach(card => {
        const cardKey = card.getAttribute('data-key');
        if (cardKey === key) {
          card.classList.add('active');
          if (isPlaying) {
            card.classList.add('playing');
          } else {
            card.classList.remove('playing');
          }
        } else {
          card.classList.remove('active');
          card.classList.remove('playing');
        }
      });

      renderTracklist();
      loadTrack(0, false); // Nạp bài hát đầu tiên nhưng chưa tự động phát
    }

    // Render danh sách bài hát trong Playlist được chọn (chung cho cả desktop và mobile)
    function renderTracklist() {
      if (!tracksListContainer) return;
      tracksListContainer.innerHTML = '';

      const pl = groupedPlaylists[activePlaylistKey];
      if (!pl || pl.tracks.length === 0) {
        tracksListContainer.innerHTML = `<div class="track-loading-placeholder">Album này chưa có giai điệu nào.</div>`;
        return;
      }

      pl.tracks.forEach((track: any, index: number) => {
        const row = document.createElement('div');
        row.className = `track-item-row ${index === activeTrackIndex ? 'active' : ''}`;
        row.setAttribute('data-index', index.toString());

        row.innerHTML = `
          <div class="track-row-left">
            <div class="track-row-icon-indicator">
              <span class="track-play-hover-btn"><i class="ph-fill ph-play-circle"></i></span>
              ${index === activeTrackIndex && isPlaying ? `
                <div class="cozy-wave-indicator">
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                </div>
              ` : `<span class="track-index-num whisper-mono">${index + 1}</span>`}
            </div>
            <div class="track-row-details">
              <span class="track-row-title">${track.title}</span>
              <span class="track-row-artist">${track.artist || 'Cozy Song 🐾'}</span>
            </div>
          </div>
          <span class="track-row-duration">${formatTime(track.duration)}</span>
        `;

        row.addEventListener('click', () => {
          loadTrack(index, true); // Nạp bài và phát ngay
        });

        tracksListContainer.appendChild(row);
      });
    }

    // Tự động lắng nghe thay đổi kích thước cửa sổ để tối ưu hóa render
    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        renderPlaylists(); // Cập nhật lại phân trang album responsive khi đổi cỡ màn hình
        renderTracklist();
        // Giữ trạng thái hiển thị track đang phát
        const activeRow = document.querySelector(`.track-item-row[data-index="${activeTrackIndex}"]`);
        if (activeRow) {
          activeRow.classList.add('active');
        }
      }, 150);
    });

    // Nạp bài hát vào player
    function loadTrack(index: number, autoPlay = true) {
      const pl = groupedPlaylists[activePlaylistKey];
      if (!pl || !pl.tracks[index]) return;

      activeTrackIndex = index;
      const track = pl.tracks[index];

      // Đổi URL công khai nếu cần
      let audioUrl = track.url || "";
      if (!audioUrl.startsWith('http') && audioUrl) {
        const r2Domain = (window as any).PUBLIC_R2_PUBLIC_DOMAIN || 'https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev';
        audioUrl = `${r2Domain.replace(/\/$/, '')}/${audioUrl}`;
      }

      audio.src = audioUrl;
      audio.load();

      if (trackTitleDisplay) trackTitleDisplay.textContent = track.title;
      if (trackArtistDisplay) trackArtistDisplay.textContent = track.artist || 'Cozy Song 🐾';

      // Cập nhật Float Mini Player
      if (miniTrackTitle) miniTrackTitle.textContent = track.title;
      if (miniTrackArtist) miniTrackArtist.textContent = track.artist || 'Cozy Song 🐾';

      // Cập nhật active indicator trên bảng tracklist
      const rows = document.querySelectorAll('.track-item-row');
      rows.forEach((row, rIdx) => {
        const indicator = row.querySelector('.track-row-icon-indicator');
        if (rIdx === index) {
          row.classList.add('active');
          if (indicator) {
            indicator.innerHTML = `
              <span class="track-play-hover-btn"><i class="ph-fill ph-play-circle"></i></span>
              ${isPlaying ? `
                <div class="cozy-wave-indicator">
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                </div>
              ` : `<span class="track-index-num whisper-mono">${index + 1}</span>`}
            `;
          }
        } else {
          row.classList.remove('active');
          if (indicator) {
            indicator.innerHTML = `
              <span class="track-play-hover-btn"><i class="ph-fill ph-play-circle"></i></span>
              <span class="track-index-num whisper-mono">${rIdx + 1}</span>
            `;
          }
        }
      });

      if (autoPlay) {
        playAudio();
      } else {
        pauseAudio();
      }
    }

    // Điều khiển phát/dừng âm thanh
    function playAudio() {
      audio.play().then(() => {
        isPlaying = true;
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
        vinylDisc?.classList.add('playing');
        vinylArm?.classList.add('active');

        // Bật xoay đĩa than trên Album active
        const activeAlbum = document.querySelector('.playlist-vinyl-item.active');
        if (activeAlbum) {
          activeAlbum.classList.add('playing');
        }

        // Bật xoay đĩa và đổi icon trên Float Mini Player
        if (miniPlayer) {
          miniPlayer.classList.add('playing');
        }
        if (miniPlayIcon) miniPlayIcon.classList.add('hidden');
        if (miniPauseIcon) miniPauseIcon.classList.remove('hidden');
        const miniPlayerWave = document.getElementById('mini-player-wave');
        if (miniPlayerWave) miniPlayerWave.classList.remove('hidden');

        // Cập nhật lại icon waveform trên hàng bài hát đang phát
        const activeRowIndicator = document.querySelector('.track-item-row.active .track-row-icon-indicator');
        if (activeRowIndicator) {
          activeRowIndicator.innerHTML = `
            <span class="track-play-hover-btn"><i class="ph-fill ph-play-circle"></i></span>
            <div class="cozy-wave-indicator">
              <span class="wave-bar"></span>
              <span class="wave-bar"></span>
              <span class="wave-bar"></span>
            </div>
          `;
        }
      }).catch(err => {
        console.warn("Không thể tự động phát nhạc:", err);
      });
    }

    function pauseAudio() {
      audio.pause();
      isPlaying = false;
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      vinylDisc?.classList.remove('playing');
      vinylArm?.classList.remove('active');

      // Tắt xoay đĩa than trên Album active
      const activeAlbum = document.querySelector('.playlist-vinyl-item.active');
      if (activeAlbum) {
        activeAlbum.classList.remove('playing');
      }

      // Tắt xoay đĩa và đổi icon trên Float Mini Player
      if (miniPlayer) {
        miniPlayer.classList.remove('playing');
      }
      if (miniPlayIcon) miniPlayIcon.classList.remove('hidden');
      if (miniPauseIcon) miniPauseIcon.classList.add('hidden');
      const miniPlayerWave = document.getElementById('mini-player-wave');
      if (miniPlayerWave) miniPlayerWave.classList.add('hidden');

      // Đổi icon waveform thành số thứ tự
      const activeRowIndicator = document.querySelector('.track-item-row.active .track-row-icon-indicator');
      if (activeRowIndicator) {
        activeRowIndicator.innerHTML = `
          <span class="track-play-hover-btn"><i class="ph-fill ph-play-circle"></i></span>
          <span class="track-index-num whisper-mono">${activeTrackIndex + 1}</span>
        `;
      }
    }

    playPauseBtn?.addEventListener('click', () => {
      if (isPlaying) {
        pauseAudio();
      } else {
        playAudio();
      }
    });

    btnNext?.addEventListener('click', () => {
      const pl = groupedPlaylists[activePlaylistKey];
      if (!pl) return;
      let nextIndex = activeTrackIndex + 1;
      if (nextIndex >= pl.tracks.length) nextIndex = 0;
      loadTrack(nextIndex, true);
    });

    btnPrev?.addEventListener('click', () => {
      const pl = groupedPlaylists[activePlaylistKey];
      if (!pl) return;
      let prevIndex = activeTrackIndex - 1;
      if (prevIndex < 0) prevIndex = pl.tracks.length - 1;
      loadTrack(prevIndex, true);
    });

    // Cập nhật thanh thời gian và tiến trình
    audio.addEventListener('timeupdate', () => {
      if (timeCurrent) timeCurrent.textContent = formatTime(audio.currentTime);
      if (timeTotal && audio.duration) timeTotal.textContent = formatTime(audio.duration);

      if (audio.duration) {
        const percent = (audio.currentTime / audio.duration) * 100;
        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressHandle) progressHandle.style.left = `${percent}%`;
        if (miniProgressBar) miniProgressBar.style.width = `${percent}%`;
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      if (timeTotal) timeTotal.textContent = formatTime(audio.duration);
    });

    // Tự động chuyển bài khi hết
    audio.addEventListener('ended', () => {
      btnNext?.click();
    });

    // Kéo thả tua nhạc (Seek)
    progressBarWrapper?.addEventListener('click', (e) => {
      const rect = progressBarWrapper.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      const clickPercent = clickX / width;
      
      if (audio.duration) {
        audio.currentTime = clickPercent * audio.duration;
      }
    });

    // Điều chỉnh âm lượng
    volumeSlider?.addEventListener('input', () => {
      audio.volume = parseFloat(volumeSlider.value);
    });

    // --- 3. FLOAT MINI PLAYER LOGIC ---
    // Điều khiển phát/dừng trên Mini Player
    miniBtnPlayPause?.addEventListener('click', () => {
      if (isPlaying) {
        pauseAudio();
      } else {
        playAudio();
      }
    });

    miniBtnNext?.addEventListener('click', () => {
      btnNext?.click();
    });

    miniBtnPrev?.addEventListener('click', () => {
      btnPrev?.click();
    });

    // Theo dõi cuộn trang hiển thị Float Mini Player (vượt quá 70% widget chính)
    window.addEventListener('scroll', () => {
      const mainPlayerCard = document.querySelector('.cozy-vinyl-card');
      if (!mainPlayerCard || !miniPlayer) return;

      const rect = mainPlayerCard.getBoundingClientRect();
      const playerHeight = rect.height;
      const playerTop = rect.top + window.scrollY;
      const triggerPoint = playerTop + playerHeight * 0.7;

      if (window.scrollY > triggerPoint) {
        miniPlayer.classList.add('visible');
      } else {
        miniPlayer.classList.remove('visible');
      }
    }, { passive: true });

    // Khởi tạo
    loadPlaylistData();
  });
</script>
