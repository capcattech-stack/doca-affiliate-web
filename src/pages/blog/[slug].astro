if (curatorName === "Latte") {
  curatorAvatar = "https://images.unsplash.com/photo-1573865526739-10659fec78a5?w=120&h=120&fit=crop&q=80"; // Latte
} else if (curatorName === "Muối") {
  curatorAvatar = "https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=120&h=120&fit=crop&q=80"; // Muối
}

// Chuyển danh mục sang tiếng Việt hoặc nhãn Pillar để hiển thị
const getCategoryLabel = (cat: string, pil?: string) => {
  if (pil) {
    const pillarLabels: Record<string, string> = {
      'nhip_tho': 'Nhịp Thở Đồng Điệu',
      'lang_kinh': 'Lăng Kính Của Pet',
      'hop_ky_uc': 'Hộp Ký Ức Bình Yên'
    };
    return pillarLabels[pil] || cat;
  }
  const labels: Record<string, string> = {
    'sach': 'Sách Chữa Lành',
    'phu_kien': 'Không Gian Chữa Lành',
    'thuc_an': 'Dinh Dưỡng Của Boss',
    'vat_pham': 'Chăm Sóc Boss'
  };
  return labels[cat] || cat;
};
---

<Layout title={`${title} | Nhật Ký Lối Sống DOCA`} description={description}>
  <!-- Truyền biến Supabase, Product Database và thông tin ảnh bìa toàn cục cho client-side JS -->
  <script is:inline define:vars={{ supabaseUrl, supabaseKey, allProducts, coverImage, title }}>
    window.PUBLIC_SUPABASE_URL = supabaseUrl;
    window.PUBLIC_SUPABASE_ANON_KEY = supabaseKey;
    window.PRODUCTS_DB = allProducts;
    window.BLOG_COVER_IMAGE = coverImage;
    window.BLOG_TITLE = title;
  </script>

  <main class="blog-detail-view">
    <header class="blog-header">
      <div class="container">
        <a href="/" class="back-link"><i class="ph-light ph-arrow-left"></i> Trở về trang chủ</a>
        
        <div class="blog-meta-top">
          <span class="category-badge">{getCategoryLabel(category, pillar)}</span>
          <span class="publish-date">{publishDate}</span>
        </div>
        
        <h1 class="blog-title">{title}</h1>
        <p class="blog-desc">{description}</p>

        <!-- Chú mèo kể chuyện (Curator Speech Bubble) -->
        <div class="blog-curator-speech-section">
          <div class="curator-profile">
            <div class="curator-speech-avatar-wrapper">
              <img src={curatorAvatar} alt={curatorName} class="curator-speech-avatar" />
              <div class="curator-paw-badge"><i class="ph-fill ph-paw"></i></div>
            </div>
            <div class="curator-speech-info">
              <span class="curator-speech-title">{curatorName} khuyên đọc 🐾</span>
            </div>
          </div>
          <div class="curator-bubble">
            <p class="curator-bubble-text">"{curatorQuote}"</p>
          </div>
        </div>

        <!-- Namiya Quick Jump Badge trực tiếp dưới Speech Bubble trong Header -->
        <div class="namiya-quick-jump header-embedded" id="namiya-quick-jump-trigger" title="Nhấn để gửi gắm tâm sự cho tụi con">
          <i class="ph-light ph-paper-plane"></i> <span>Gửi tâm sự ẩn danh cho tụi con nhé ✉</span>
        </div>
      </div>
    </header>

    <article class="blog-body">
      <div class="container">
        <div class="markdown-content">
          <Content />
        </div>
      </div>
    </article>

    <!-- Kệ hiển thị sản phẩm liên quan gợi ý -->
    {products.length > 0 && (
      <section class="related-products-section">
        <div class="container">
          <h3 class="section-title"><i class="ph-light ph-gift"></i> Quà tặng Mẹ Lin đã chọn</h3>
          <div class="products-grid">
            {products.map(product => (
              <ProductCard 
                id={product.id}
                slug={product.slug}
                name={product.name}
                category={getCategoryLabel(product.category)}
                price={product.price}
                wholesalePrice={product.wholesale_price}
                minGroupSize={product.min_group_size}
                affiliateUrl={product.affiliate_url}
                imageUrl={product.image_url}
                quote={product.quote}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Hòm thư gỗ Namiya ở cuối bài viết -->
    <section class="mailbox-section">
      <div class="container">
        <NamiyaMailbox />
      </div>
    </section>
  </main>

  <!-- Polaroid Bottom Sheet mở toàn cục -->
  <PolaroidSheet />

  <!-- Script liên kết sản phẩm thông minh và Namiya Quick Jump -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Quét và chèn Inline Curation Cards
      // 2. Namiya Quick Jump Scroll
      const quickJumpBtn = document.getElementById('namiya-quick-jump-trigger');
      quickJumpBtn?.addEventListener('click', () => {
        const mailboxSection = document.querySelector('.mailbox-section');
        if (mailboxSection) {
          mailboxSection.scrollIntoView({ behavior: 'smooth' });
          
          // Trượt mở hòm thư tự động
          setTimeout(() => {
            const formContainer = document.getElementById('namiya-form-container');
            const collapsedState = document.getElementById('namiya-collapsed-state');
            if (formContainer && collapsedState) {
              collapsedState.classList.add('hidden');
              formContainer.classList.add('open');
            }
          }, 800);
        }
      });

      // 3. Tự động chèn ảnh bìa (coverImage) xen kẽ vào giữa thân bài viết (sau đoạn văn thứ 2)
      const articleBody = document.querySelector('.markdown-content');
      const blogCoverUrl = (window as any).BLOG_COVER_IMAGE;
      const blogTitle = (window as any).BLOG_TITLE;

      if (articleBody && blogCoverUrl) {
        const paragraphs = articleBody.querySelectorAll('p');
        if (paragraphs.length >= 2) {
          // Tạo thẻ figure bọc ảnh bìa
          const figure = document.createElement('figure');
          figure.className = 'blog-body-inline-image-wrapper';
          
          const img = document.createElement('img');
          img.src = blogCoverUrl;
          img.alt = blogTitle || 'Ảnh minh họa';
          img.className = 'blog-body-inline-image';
          
          const caption = document.createElement('figcaption');
          caption.className = 'blog-body-inline-caption';
          caption.innerText = blogTitle || '';
          
          figure.appendChild(img);
          if (blogTitle) {
            figure.appendChild(caption);
          }
          
          // Chèn vào sau đoạn văn thứ 2 (index 1)
          const insertIndex = Math.min(1, paragraphs.length - 1);
          paragraphs[insertIndex].after(figure);
        }
      }
    });
  </script>
</Layout>

<style>
  .blog-detail-view {
    padding-top: 2rem;
    padding-bottom: 4rem;
    background-color: var(--cozy-bg-beige);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--cozy-text-obsidian);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .blog-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .category-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cozy-green-matcha);
    border: 1px solid var(--cozy-green-matcha);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-tag);
    text-transform: uppercase;
  }

  .publish-date {
    font-size: 0.85rem;
    color: #8E8E93;
  }

  .blog-title {
    margin-bottom: 0.5rem;
  }

  .blog-desc {
    font-size: 1.1rem;
    color: #6E6E73;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .blog-cover-container {
    margin-bottom: 2rem;
  }

  .blog-cover {
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--cozy-border-light);
    box-shadow: var(--cozy-shadow-default);
  }

  .blog-body {
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* Định dạng typography bài viết Markdown */
  .markdown-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    color: var(--cozy-text-obsidian);
    text-align: justify;
  }

  .markdown-content :global(h2) {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--cozy-text-obsidian);
  }

  .markdown-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--cozy-border-light);
    box-shadow: var(--cozy-shadow-default);
  }

  .markdown-content :global(h3) {
    font-family: 'Inter', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .markdown-content :global(blockquote) {
    border-left: 4px solid var(--cozy-green-matcha);
    background-color: var(--cozy-bg-beige);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 4px;
  }

  .markdown-content :global(blockquote p) {
    font-family: 'Space Mono', monospace;
    font-style: italic;
    font-size: 0.95rem;
    margin-bottom: 0;
    color: #5D4037;
  }

  .markdown-content :global(ul) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .markdown-content :global(li) {
    font-size: 1.1rem;
    color: var(--cozy-text-obsidian);
  }

  .markdown-content :global(strong) {
    font-weight: 600;
  }

  /* Kệ sản phẩm gợi ý */
  .related-products-section {
    background-color: var(--cozy-bg-beige);
    border-top: 1px solid var(--cozy-border-light);
    border-bottom: 1px solid var(--cozy-border-light);
    padding: 3rem 0;
    margin-bottom: 3rem;
  }

  .section-title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* Mobile: 2 cột */
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr); /* Tablet: 3 cột */
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(5, 1fr); /* Desktop: 5 cột */
      gap: 1.25rem;
    }
  }

  .mailbox-section {
    margin-top: 2rem;
  }

  /* Chú mèo kể chuyện (Curator Speech Bubble) */
  .blog-curator-speech-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
