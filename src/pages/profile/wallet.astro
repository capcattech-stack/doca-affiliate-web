---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ví Cá & Nạp Tiền | DOCA" description="Quản lý số dư cá và nạp cá trực tuyến qua ZaloPay/MoMo.">
  <main class="wallet-view">
    <div class="wallet-page-container">
      <!-- Nút quay lại Profile -->
      <div class="wallet-nav-header">
        <a href="/profile" class="back-link"><i class="ph-light ph-arrow-left"></i> Trở về Hồ sơ</a>
      </div>

      <!-- Tab điều hướng -->
      <div class="wallet-tabs">
        <button class="wallet-tab-btn active" id="tab-recharge-btn">Nạp <i class="ph-light ph-plus-circle"></i></button>
        <button class="wallet-tab-btn" id="tab-history-btn">Lịch Sử Giao Dịch <i class="ph-light ph-clock-counter-clockwise"></i></button>
      </div>

      <!-- VÙNG 1: NẠP CÁ -->
      <div class="wallet-content-section" id="section-recharge">
        <div class="wallet-balance-card">
          <div class="balance-title">Số dư hiện tại của bạn</div>
          <div class="balance-value" id="current-balance" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem;">... <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i></div>
        </div>

        <h2 class="section-title">Chọn gói nạp</h2>
        <div class="packages-grid" id="packages-container">
          <div class="loading-placeholder text-center">
            <i class="ph-light ph-spinner-gap spin" style="font-size: 1.5rem; color: var(--cozy-green-matcha-forest);"></i>
            <p class="whisper-mono" style="font-size: 0.8rem; margin-top: 0.5rem;">Đang tải các gói nạp...</p>
          </div>
        </div>

        <!-- Trình chọn cổng thanh toán -->
        <!-- Bottom Sheet Chọn phương thức thanh toán -->
        <div class="cozy-bottom-sheet-overlay hidden" id="payment-sheet-overlay">
          <div class="cozy-bottom-sheet" id="payment-sheet">
            <div class="sheet-header">
              <div class="sheet-handle"></div>
              <h3 class="sheet-title" style="display: inline-flex; align-items: center; gap: 0.25rem;">Xác nhận nạp <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i></h3>
              <button class="sheet-close-btn" id="sheet-close-btn" aria-label="Đóng"><i class="ph-light ph-x"></i></button>
            </div>
            
            <div class="sheet-body">
              <!-- Thông tin gói đã chọn -->
              <div class="selected-package-summary">
                <div class="summary-left">
                  <div class="summary-name" id="selected-pkg-name">Gói...</div>
                  <div class="summary-desc" id="selected-pkg-desc">Mô tả gói...</div>
                </div>
                <div class="summary-right">
                  <div class="summary-coin" id="selected-pkg-coin" style="display: inline-flex; align-items: center; gap: 0.2rem;">0 <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i></div>
                  <div class="summary-price" id="selected-pkg-price">0đ</div>
                </div>
              </div>

              <h3 class="method-title">Chọn phương thức thanh toán</h3>
              <div class="methods-list">
                <label class="method-item active">
                  <input type="radio" name="payment-provider" value="ZALOPAY" checked />
                  <div class="method-details">
                    <i class="ph-light ph-credit-card" style="font-size: 1.25rem; color: #008FE5;"></i>
                    <span>Ví điện tử ZaloPay (Quét mã QR / App)</span>
                  </div>
                </label>
                <label class="method-item">
                  <input type="radio" name="payment-provider" value="MOCK" />
                  <div class="method-details">
                    <i class="ph-light ph-lightning" style="font-size: 1.25rem; color: var(--cozy-green-matcha-forest);"></i>
                    <span>Mock Sandbox (Thử nghiệm tức thì - 0đ)</span>
                  </div>
                </label>
              </div>
              
              <button class="cozy-btn pay-btn" id="confirm-pay-btn" disabled>
                Tiến hành thanh toán <i class="ph-light ph-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- VÙNG 2: LỊCH SỬ GIAO DỊCH -->
      <div class="wallet-content-section hidden" id="section-history">
        <div class="history-list" id="history-list-container">
          <div class="loading-placeholder text-center">
            <i class="ph-light ph-spinner-gap spin" style="font-size: 1.5rem; color: var(--cozy-green-matcha-forest);"></i>
            <p class="whisper-mono" style="font-size: 0.8rem; margin-top: 0.5rem;">Đang tải lịch sử giao dịch...</p>
          </div>
        </div>
      </div>

      <!-- MODAL CHỜ THANH TOÁN & QUÉT QR (COZY MUJI MODAL) -->
      <div class="cozy-modal-overlay hidden" id="payment-modal">
        <div class="cozy-modal-card">
          <div class="modal-header">
            <h3 id="modal-title">Quét mã để nạp Cá</h3>
            <p id="modal-subtitle">Mở ứng dụng ZaloPay hoặc Camera trên điện thoại để quét mã</p>
          </div>
          <div class="modal-body text-center">
            <!-- QR Code Container -->
            <div id="qr-code-wrapper" style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin: 0.5rem 0;">
              <div id="qr-image-container" style="background: #ffffff; padding: 12px; border-radius: 12px; border: 1px solid var(--cozy-border-light); box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
                <img id="qr-code-img" src="" alt="Mã QR ZaloPay" style="width: 180px; height: 180px; display: block; border-radius: 8px;" />
              </div>
              <div style="font-size: 0.78rem; color: var(--cozy-text-charcoal); opacity: 0.85;">
                Mã đơn: <b id="modal-order-id" style="font-family: monospace;">--</b>
              </div>
            </div>

            <!-- Loading Spinner State -->
            <div id="modal-spinner-state" class="hidden">
              <div class="spinner-large">
                <i class="ph-light ph-spinner-gap spin" style="font-size: 3rem; color: var(--cozy-green-matcha-forest);"></i>
              </div>
            </div>

            <!-- Success State -->
            <div id="modal-success-state" class="hidden" style="padding: 1rem 0;">
              <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(118, 193, 35, 0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: var(--cozy-green-matcha-forest); font-size: 32px;">
                <i class="ph-fill ph-check-circle"></i>
              </div>
              <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--cozy-text-obsidian); margin-bottom: 0.25rem;">Nạp Cá Thành Công!</h4>
              <p style="font-size: 0.82rem; color: var(--cozy-text-charcoal); opacity: 0.85;" id="modal-success-msg">Số dư mới của bạn đã được cập nhật tức thì.</p>
            </div>

            <p class="status-text" id="modal-status-text" style="margin-top: 0.25rem;">
              <i class="ph-light ph-arrows-clockwise spin" style="font-size: 0.9rem; vertical-align: middle;"></i> Đang chờ nhận thanh toán...
            </p>
            
            <a href="#" id="modal-payment-link" target="_blank" class="cozy-btn link-btn">
              Mở link thanh toán trực tiếp <i class="ph-light ph-arrow-square-out"></i>
            </a>
          </div>
          <div class="modal-footer">
            <button class="close-modal-btn" id="close-modal-btn">Đóng / Hủy giao dịch</button>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  import { getSupabase } from '../../scripts/supabase';
  import {
    getCoinPackages,
    createRechargeOrder,
    getOrderStatus,
    getWalletBalance,
    getWalletHistory,
    type CoinPackage,
    COIN_HUB_API_URL
  } from '../../scripts/coinHubApi';

  document.addEventListener('DOMContentLoaded', async () => {
    const balanceEl = document.getElementById('current-balance');
    const packagesContainer = document.getElementById('packages-container');
    const confirmPayBtn = document.getElementById('confirm-pay-btn') as HTMLButtonElement;
    
    // Bottom Sheet elements
    const paymentSheetOverlay = document.getElementById('payment-sheet-overlay');
    const paymentSheet = document.getElementById('payment-sheet');
    const sheetCloseBtn = document.getElementById('sheet-close-btn');
    const selectedPkgName = document.getElementById('selected-pkg-name');
    const selectedPkgDesc = document.getElementById('selected-pkg-desc');
    const selectedPkgCoin = document.getElementById('selected-pkg-coin');
    const selectedPkgPrice = document.getElementById('selected-pkg-price');
    
    // Tab buttons and sections
    const tabRechargeBtn = document.getElementById('tab-recharge-btn');
    const tabHistoryBtn = document.getElementById('tab-history-btn');
    const sectionRecharge = document.getElementById('section-recharge');
    const sectionHistory = document.getElementById('section-history');
    const historyContainer = document.getElementById('history-list-container');

    // Modal elements
    const paymentModal = document.getElementById('payment-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalSubtitle = document.getElementById('modal-subtitle');
    const qrCodeWrapper = document.getElementById('qr-code-wrapper');
    const qrCodeImg = document.getElementById('qr-code-img') as HTMLImageElement;
    const modalOrderId = document.getElementById('modal-order-id');
    const modalSpinnerState = document.getElementById('modal-spinner-state');
    const modalSuccessState = document.getElementById('modal-success-state');
    const modalStatusText = document.getElementById('modal-status-text');
    const modalPaymentLink = document.getElementById('modal-payment-link') as HTMLAnchorElement;
    const closeModalBtn = document.getElementById('close-modal-btn');

    let selectedPackageId = '';
    let currentBalance = 0;
    let pollInterval: any = null;
    let activeUserIdentifier: { email?: string; phone?: string } = {};

    // 1. Kiểm tra session Supabase Auth
    const client = getSupabase();
    let currentUser: any = null;

    if (client) {
      const { data: { session } } = await client.auth.getSession();
      currentUser = session?.user;
    }

    // Kiểm tra thông tin người dùng đã đăng nhập
    if (currentUser) {
      activeUserIdentifier = {
        email: currentUser.email || undefined,
        phone: currentUser.phone || undefined
      };
    } else {
      activeUserIdentifier = null;
    }

    // Tải số dư ban đầu từ CoinHub API
    await refreshBalance();

    // Tải danh sách các gói nạp từ CoinHub Backend
    await loadPackages();

    // Kiểm tra tab query param
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'history') {
      activateTab('history');
    }

    // 2. Chuyển đổi giữa các Tabs
    tabRechargeBtn?.addEventListener('click', () => activateTab('recharge'));
    tabHistoryBtn?.addEventListener('click', () => activateTab('history'));

    function activateTab(tab: 'recharge' | 'history') {
      if (tab === 'recharge') {
        tabRechargeBtn?.classList.add('active');
        tabHistoryBtn?.classList.remove('active');
        sectionRecharge?.classList.remove('hidden');
        sectionHistory?.classList.add('hidden');
      } else {
        tabHistoryBtn?.classList.add('active');
        tabRechargeBtn?.classList.remove('active');
        sectionHistory?.classList.remove('hidden');
        sectionRecharge?.classList.add('hidden');
        loadHistory();
      }
    }

    // 3. Tải danh sách gói nạp từ CoinHub Microservice
    async function loadPackages() {
      if (!packagesContainer) return;
      
      try {
        const packages = await getCoinPackages('doca');
        
        if (!packages || packages.length === 0) {
          packagesContainer.innerHTML = '<div class="whisper-mono text-center" style="grid-column: 1/-1; padding: 2rem 0; opacity: 0.7;">Chưa có gói nạp nào được kích hoạt.</div>';
          return;
        }

        packagesContainer.innerHTML = '';
        packages.forEach((pkg: CoinPackage) => {
          const card = document.createElement('div');
          card.className = 'package-card';
          card.dataset.id = pkg.id;
          
          const bonusBadge = pkg.bonusPercentage > 0 
            ? `<div class="bonus-badge" style="display: inline-flex; align-items: center; gap: 0.15rem;">+${pkg.bonusPercentage}% <i class="ph-fill ph-sparkle" style="font-size: 0.75rem;"></i></div>` 
            : '';

          card.innerHTML = `
            ${bonusBadge}
            <div class="package-name">${pkg.name}</div>
            <div class="package-coin">
              <span>${Number(pkg.coinAmount).toLocaleString('vi-VN')} <i class="ph-fill ph-fish" style="font-size: 0.85rem; color: var(--cozy-green-matcha-forest);"></i></span>
            </div>
            <div class="package-price">${Number(pkg.amountVnd).toLocaleString('vi-VN')} đ</div>
            <div class="package-desc" style="font-size: 0.72rem; color: var(--cozy-text-charcoal); opacity: 0.75; margin-top: 0.25rem;">Nạp tức thì qua ZaloPay</div>
          `;

          card.addEventListener('click', () => {
            document.querySelectorAll('.package-card').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            selectedPackageId = pkg.id;
            
            // Cập nhật thông tin gói trên Bottom Sheet
            if (selectedPkgName) selectedPkgName.textContent = pkg.name;
            if (selectedPkgDesc) selectedPkgDesc.textContent = `Quy đổi ${Number(pkg.amountVnd).toLocaleString('vi-VN')}đ thành ${Number(pkg.coinAmount)} Cá`;
            if (selectedPkgCoin) selectedPkgCoin.innerHTML = `${Number(pkg.coinAmount).toLocaleString('vi-VN')} <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest); font-size: 1.15rem;"></i>`;
            if (selectedPkgPrice) selectedPkgPrice.textContent = `${Number(pkg.amountVnd).toLocaleString('vi-VN')}đ`;

            // Mở Bottom Sheet
            if (paymentSheetOverlay) paymentSheetOverlay.classList.remove('hidden');
            if (paymentSheet) {
              setTimeout(() => paymentSheet.classList.add('open'), 10);
            }
            document.body.classList.add('overflow-hidden');

            if (confirmPayBtn) {
              confirmPayBtn.removeAttribute('disabled');
            }
          });

          packagesContainer.appendChild(card);
        });
      } catch (err) {
        console.error('[CoinHub] Lỗi load packages:', err);
        packagesContainer.innerHTML = '<div class="text-center" style="grid-column: 1/-1; color: #d32f2f;">Không thể kết nối Backend Coin Hub (:3005).</div>';
      }
    }

    // 4. Lắng nghe thay đổi phương thức thanh toán & Đóng Bottom Sheet
    const methodItems = document.querySelectorAll('.method-item');
    methodItems.forEach(item => {
      item.addEventListener('click', () => {
        methodItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        const input = item.querySelector('input[type="radio"]') as HTMLInputElement;
        if (input) input.checked = true;
      });
    });

    function closePaymentSheet() {
      if (paymentSheet) paymentSheet.classList.remove('open');
      setTimeout(() => {
        if (paymentSheetOverlay) paymentSheetOverlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 300);
    }

    sheetCloseBtn?.addEventListener('click', closePaymentSheet);
    paymentSheetOverlay?.addEventListener('click', (e) => {
      if (e.target === paymentSheetOverlay) {
        closePaymentSheet();
      }
    });

    // 5. Nút bấm Tạo Đơn & Tiến Hành Thanh Toán
    confirmPayBtn?.addEventListener('click', async () => {
      if (!selectedPackageId) return;

      if (!activeUserIdentifier || (!activeUserIdentifier.email && !activeUserIdentifier.phone)) {
        alert('Vui lòng đăng nhập tài khoản DOCA để tiến hành nạp Cá vào ví của bạn.');
        window.location.href = '/profile';
        return;
      }
      
      confirmPayBtn.disabled = true;
      confirmPayBtn.innerHTML = `Đang tạo đơn... <i class="ph-light ph-spinner-gap spin"></i>`;

      const provider = (document.querySelector('input[name="payment-provider"]:checked') as HTMLInputElement)?.value as 'ZALOPAY' | 'MOCK' || 'ZALOPAY';

      try {
        const orderData = await createRechargeOrder({
          email: activeUserIdentifier.email,
          phone: activeUserIdentifier.phone,
          packageId: selectedPackageId,
          gateway: provider,
          tenantId: 'doca',
        });

        // Đóng Bottom Sheet
        closePaymentSheet();

        // Mở Modal Quét QR / Chờ thanh toán
        if (paymentModal) paymentModal.classList.remove('hidden');
        
        // Reset modal states
        if (modalSuccessState) modalSuccessState.classList.add('hidden');
        if (modalSpinnerState) modalSpinnerState.classList.add('hidden');
        if (qrCodeWrapper) qrCodeWrapper.classList.remove('hidden');
        if (modalPaymentLink) modalPaymentLink.classList.remove('hidden');

        if (modalOrderId) modalOrderId.textContent = orderData.order_id.substring(0, 8) + '...';
        if (modalPaymentLink) modalPaymentLink.href = orderData.order_url;

        // Render QR Code cho ZaloPay hoặc Mock
        if (orderData.qr_code || orderData.order_url) {
          const qrPayload = orderData.qr_code || orderData.order_url;
          if (qrCodeImg) {
            qrCodeImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(qrPayload)}`;
          }
        }

        if (provider === 'MOCK') {
          if (modalTitle) modalTitle.textContent = 'Mock Sandbox Đang Xử Lý';
          if (modalSubtitle) modalSubtitle.textContent = 'Hệ thống giả lập thanh toán tức thì trong môi trường Staging/Dev';
          if (modalStatusText) modalStatusText.innerHTML = '<i class="ph-light ph-arrows-clockwise spin"></i> Đang giả lập thanh toán... (tự động sau 1.5s)';

          // Tự động kích hoạt Mock Payment Webhook sau 1.5s
          setTimeout(async () => {
            try {
              await fetch(`${COIN_HUB_API_URL}/api/v1/webhooks/mock`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  orderId: orderData.order_id,
                  amountVnd: orderData.amount_vnd,
                }),
              });
            } catch (mockErr) {
              console.warn('[Mock Pay Trigger]', mockErr);
            }
          }, 1500);
        } else {
          if (modalTitle) modalTitle.textContent = 'Quét mã QR ZaloPay';
          if (modalSubtitle) modalSubtitle.textContent = 'Mở ứng dụng ZaloPay hoặc camera quét mã để hoàn tất';
          if (modalStatusText) modalStatusText.innerHTML = '<i class="ph-light ph-arrows-clockwise spin"></i> Đang chờ nhận thanh toán từ ZaloPay...';
        }

        // Bắt đầu vòng lặp Polling trạng thái đơn hàng
        startPolling(orderData.order_id);

      } catch (err: any) {
        console.error('[CoinHub] Lỗi tạo đơn thanh toán:', err);
        alert(err.message || 'Có lỗi xảy ra khi kết nối tới cổng thanh toán.');
      } finally {
        confirmPayBtn.disabled = false;
        confirmPayBtn.innerHTML = `Tiến hành thanh toán <i class="ph-light ph-arrow-right"></i>`;
      }
    });

    // 6. Đóng Modal & Dừng Polling
    closeModalBtn?.addEventListener('click', () => {
      stopPolling();
      if (paymentModal) paymentModal.classList.add('hidden');
    });

    function startPolling(orderId: string) {
      stopPolling();

      pollInterval = setInterval(async () => {
        try {
          const statusResult = await getOrderStatus(orderId);

          if (statusResult && statusResult.status === 'SUCCESS') {
            stopPolling();

            // Hiển thị trạng thái thành công
            if (qrCodeWrapper) qrCodeWrapper.classList.add('hidden');
            if (modalPaymentLink) modalPaymentLink.classList.add('hidden');
            if (modalStatusText) modalStatusText.classList.add('hidden');
            if (modalSuccessState) modalSuccessState.classList.remove('hidden');
            if (modalTitle) modalTitle.textContent = 'Giao Dịch Hoàn Tất 🎉';
            if (modalSubtitle) modalSubtitle.textContent = 'Cảm ơn bạn đã đồng hành cùng Doca Pet!';

            // Cập nhật số dư mới tức thì
            await refreshBalance();

            // Tự động đóng modal sau 2.5s
            setTimeout(() => {
              if (paymentModal) paymentModal.classList.add('hidden');
            }, 2500);
          } else if (statusResult && (statusResult.status === 'FAILED' || statusResult.status === 'EXPIRED')) {
            stopPolling();
            if (modalStatusText) {
              modalStatusText.innerHTML = '<span style="color: #d32f2f;"><i class="ph-light ph-x-circle"></i> Đơn hàng đã hết hạn hoặc thất bại.</span>';
            }
          }
        } catch (err) {
          console.warn('[CoinHub Polling]', err);
        }
      }, 2500);
    }

    function stopPolling() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    // 7. Hàm làm mới số dư Cá từ Backend CoinHub
    async function refreshBalance() {
      try {
        const balanceData = await getWalletBalance(activeUserIdentifier);
        currentBalance = balanceData.balance;
        if (balanceEl) {
          balanceEl.innerHTML = `${Number(currentBalance).toLocaleString('vi-VN')} <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i>`;
        }
      } catch (err) {
        console.error('[CoinHub] Lỗi tải số dư:', err);
        if (balanceEl) {
          balanceEl.innerHTML = `0 <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i>`;
        }
      }
    }

    // 8. Tải lịch sử biến động số dư Sổ cái bất biến
    async function loadHistory() {
      if (!historyContainer) return;
      
      try {
        const transactions = await getWalletHistory(activeUserIdentifier, 30);

        if (!transactions || transactions.length === 0) {
          historyContainer.innerHTML = '<div class="no-history text-center whisper-mono" style="font-size: 0.82rem; padding: 2.5rem 0; opacity: 0.7;">Chưa có biến động số dư nào trong ví. 🐾</div>';
          return;
        }

        historyContainer.innerHTML = '';
        transactions.forEach((tx: any) => {
          const date = new Date(tx.createdAt || tx.created_at).toLocaleString('vi-VN', {
            hour: '2-digit',
            minute: '2-digit',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
          });

          const amountNum = Number(tx.amount);
          const isPlus = amountNum > 0;
          const classAmount = isPlus ? 'tx-amount plus' : 'tx-amount minus';
          const symbol = isPlus ? '+' : '';

          let typeLabel = 'Biến động số dư';
          if (tx.type === 'RECHARGE') typeLabel = 'Nạp Cá (ZaloPay/Mock)';
          else if (tx.type === 'SPEND') typeLabel = 'Chi tiêu mở khóa dịch vụ';
          else if (tx.type === 'BONUS') typeLabel = 'Thưởng khuyến mại';
          else if (tx.type === 'MANUAL_CREDIT') typeLabel = 'Bù Cá từ quản trị viên';
          else if (tx.type === 'REFUND') typeLabel = 'Hoàn trả số dư';

          const item = document.createElement('div');
          item.className = 'history-item';
          item.innerHTML = `
            <div class="tx-left">
              <div class="tx-type" style="display: flex; align-items: center; gap: 0.35rem;">
                <i class="ph-light ${isPlus ? 'ph-arrow-down-left' : 'ph-arrow-up-right'}" style="color: ${isPlus ? 'var(--cozy-green-matcha-forest)' : 'var(--cozy-text-obsidian)'}; font-size: 1rem;"></i>
                ${typeLabel}
              </div>
              <div class="tx-date">${date} ${tx.sourceRef ? `• Mã: ${tx.sourceRef.substring(0, 8)}...` : ''}</div>
            </div>
            <div class="${classAmount}" style="display: inline-flex; align-items: center; gap: 0.15rem;">
              ${symbol}${amountNum.toLocaleString('vi-VN')} <i class="ph-fill ph-fish" style="font-size: 0.85rem;"></i>
            </div>
          `;
          historyContainer.appendChild(item);
        });

      } catch (err) {
        console.error('[CoinHub] Lỗi load lịch sử:', err);
        historyContainer.innerHTML = '<div class="no-history text-center" style="padding: 2rem 0; color: #d32f2f;">Không thể tải lịch sử giao dịch từ Coin Hub.</div>';
      }
    }
  });
</script>

