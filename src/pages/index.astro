  .blog-item:hover {
    border-left-color: #76C123; /* Neon Green */
  }

  .blog-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 0.5rem;
  }

  .blog-category {
    font-size: 0.65rem;
    font-weight: 700;
