// Lọc các sản phẩm liên quan từ Supabase
if (allProducts.length === 0) {
  allProducts = STATIC_PRODUCTS_FALLBACK;
}

let products = allProducts.filter(p => relatedProducts.includes(p.slug));

// Fallback thông minh: nếu không có sản phẩm liên quan chỉ định, tự động lấy sản phẩm cùng loại
if (products.length === 0) {
  const categoryMap: Record<string, string> = {
    'sach': 'sach',
    'routine': 'thuc_an',
    'setup': 'phu_kien'
  };
  const targetProductCat = categoryMap[category] || 'vat_pham';
  products = allProducts.filter(p => p.category === targetProductCat).slice(0, 2);
  if (products.length === 0) {
    products = allProducts.slice(0, 2);
  }
}

// Lấy thông tin chú mèo tuyển chọn trực tiếp từ frontmatter bài viết
const curatorName = entry.data.curatorName || "Tina";
const curatorQuote = entry.data.curatorQuote || "Tina hi vọng bài viết này mang lại sự nhẹ nhõm cho cô/chú nha...";
