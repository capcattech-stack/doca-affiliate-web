---
// Component soạn thảo bài viết Blog phong cách Notion tối giản tích hợp AI Hiệu Đính
// Thiết kế và tinh chỉnh bởi Maya (UI/UX Designer) theo đúng tinh thần Muji Minimalism & Iyashikei
// Hỗ trợ Thanh bên (Left Sidebar) quản lý bài viết động từ Supabase
---

<div class="notion-editor-container" id="editor-container">
  
  <!-- Left Sidebar: Quản lý danh sách bài viết -->
  <aside class="editor-sidebar" id="editor-sidebar">
    <div class="sidebar-header">
      <span class="sidebar-title"><i class="ph-light ph-notebook"></i> Bản thảo của tôi</span>
      <button type="button" class="btn-new-post" id="btn-new-post-sidebar" title="Tạo bài viết mới">
        <i class="ph-light ph-plus"></i> Bài mới
      </button>
    </div>
    
    <!-- Danh sách bài viết sẽ được render động ở đây -->
    <div class="sidebar-list" id="sidebar-blog-list">
      <div class="sidebar-loading"><i class="ph-light ph-spinner-gap spin"></i> Đang tải...</div>
    </div>

    <!-- Góc tài khoản người dùng dưới chân sidebar -->
    <div class="sidebar-footer">
      <div class="user-capsule">
        <i class="ph-light ph-user-circle"></i>
        <span class="user-email-text" id="sidebar-user-email">Đang kết nối...</span>
      </div>
    </div>
  </aside>

  <!-- Vùng làm việc chính bên phải -->
  <div class="editor-workspace-wrapper">
    <!-- Header Bar: Nắp gập thông minh chứa nút Toggle Sidebar, Toolbar và các nút hành động chính -->
    <header class="editor-header-bar">
      <div class="header-left-group">
        <!-- Nút Toggle đóng mở Sidebar kiểu Notion -->
        <button type="button" class="toolbar-btn sidebar-toggle-btn active" id="btn-toggle-sidebar" title="Đóng/Mở thanh bên">
          <i class="ph-light ph-sidebar-simple"></i>
        </button>

        <a href="/blog" class="editor-back-link" title="Quay lại trang Blog">
          <i class="ph-light ph-caret-left"></i> Trang Blog
        </a>
        
        <span class="header-divider-vertical"></span>

        <!-- Toolbar Định dạng Tối Giản -->
        <div class="editor-toolbar" id="editor-toolbar">
          <button type="button" class="toolbar-btn" data-action="bold" title="In đậm (Ctrl+B)"><i class="ph-light ph-text-bolder"></i></button>
          <button type="button" class="toolbar-btn" data-action="italic" title="In nghiêng (Ctrl+I)"><i class="ph-light ph-text-italic"></i></button>
          <button type="button" class="toolbar-btn" data-action="h2" title="Tiêu đề lớn H2"><i class="ph-light ph-text-h-two"></i></button>
          <button type="button" class="toolbar-btn" data-action="h3" title="Tiêu đề phụ H3"><i class="ph-light ph-text-h-three"></i></button>
          <button type="button" class="toolbar-btn" data-action="blockquote" title="Trích dẫn chữ"><i class="ph-light ph-quotes"></i></button>
          <button type="button" class="toolbar-btn" data-action="bulletList" title="Danh sách liệt kê"><i class="ph-light ph-list-bullets"></i></button>
          <span class="toolbar-divider"></span>
          <button type="button" class="toolbar-btn" id="insert-image-btn" title="Chèn ảnh minh họa"><i class="ph-light ph-image"></i></button>
          <button type="button" class="toolbar-btn" id="insert-product-btn" title="Nhúng Card sản phẩm Kiosk"><i class="ph-light ph-gift"></i></button>
        </div>
      </div>

      <!-- Nhóm nút hành động bên phải -->
      <div class="editor-action-buttons">
        <!-- Nút hiệu đính AI nổi bật với hiệu ứng phát sáng nhẹ -->
        <button type="button" class="btn-ai-trigger" id="btn-open-ai-sheet">
          <i class="ph-fill ph-sparkle"></i> Hiệu đính AI
        </button>
        
        <!-- Nút thiết lập mở Drawer -->
        <button type="button" class="btn-settings-toggle" id="btn-toggle-settings" title="Thiết lập thuộc tính bài viết">
          <i class="ph-light ph-sliders"></i> Cấu hình
        </button>
        
        <button type="button" class="btn-publish-action" id="btn-publish-main">
          <i class="ph-light ph-paper-plane-launch"></i> Đăng bài
        </button>
      </div>
    </header>

    <!-- Panel Thiết lập bài viết (Trượt ẩn/hiện) -->
    <div class="editor-settings-drawer hidden" id="editor-settings-drawer">
      <div class="drawer-header">
        <h4><i class="ph-light ph-gear"></i> Thuộc tính bài viết</h4>
        <button type="button" id="btn-close-settings" class="btn-close-drawer">&times;</button>
      </div>
      <div class="drawer-body">
        <div class="form-group">
          <label for="blog-desc">Mô tả ngắn gọn (SEO)</label>
          <textarea id="blog-desc" rows="3" placeholder="Ví dụ: Lời khuyên chân thành giúp giải tỏa áp lực cho Sen khi Boss biếng ăn..."></textarea>
        </div>

        <div class="form-group">
          <label for="blog-category">Danh mục bài đăng</label>
          <select id="blog-category">
            <option value="vat_pham">Chăm Sóc Thú Cưng 🐾</option>
            <option value="thuc_an">Dinh Dưỡng Cho Boss 🐟</option>
            <option value="sach">Sách & Kiến Thức 📚</option>
            <option value="phu_kien">Không Gian Sống Xanh 🌿</option>
          </select>
        </div>

        <div class="form-group">
          <label for="blog-pillar">Trụ cột lối sống (Pillar)</label>
          <select id="blog-pillar">
            <option value="nhip_tho">Nhịp Thở Đồng Diệu</option>
            <option value="lang_kinh">Lăng Kính Của Pet</option>
            <option value="hop_ky_uc">Hộp Ký Ức Bình Yên</option>
          </select>
        </div>

        <div class="form-group">
          <label for="blog-cover">Đường dẫn ảnh bìa bài viết</label>
          <input type="text" id="blog-cover" placeholder="Dán link ảnh Unsplash..." />
        </div>
        
        <div class="drawer-footer-actions">
          <button type="button" class="btn-save-draft-secondary" id="btn-save-draft"><i class="ph-light ph-floppy-disk"></i> Lưu bản nháp</button>
        </div>
      </div>
    </div>

    <!-- Vùng soạn thảo chính (Notion-style) -->
    <main class="notion-workspace">
      <div class="notion-sheet-page">
        <!-- Input tiêu đề bài viết lớn, tinh tế và borderless -->
        <input type="text" id="blog-title" class="notion-title-input" placeholder="Tiêu đề bài viết..." autofocus />
        
        <!-- Canvas Editor Tiptap -->
        <div class="tiptap-editor-container">
          <div id="editor-canvas"></div>
        </div>
      </div>
    </main>
  </div>

  <!-- Bottom Sheet Hiệu Đính AI (Slide up mượt mà) -->
  <div id="ai-bottom-sheet" class="cozy-bottom-sheet">
    <div class="cozy-sheet-backdrop" id="ai-sheet-backdrop"></div>
    <div class="cozy-sheet-content">
      <div class="cozy-sheet-drag-handle"></div>
      
      <div class="cozy-sheet-header">
        <div class="ai-badge-capsule">
          <i class="ph-fill ph-sparkle"></i> Trợ Lý Hiệu Đính AI
        </div>
        <button type="button" id="ai-sheet-close-btn" class="sheet-close-btn">
          <i class="ph-light ph-x"></i>
        </button>
      </div>

      <div class="cozy-sheet-body">
        <div class="ai-layout-grid">
          <!-- Cột tùy chỉnh chế độ AI -->
          <div class="ai-options-panel">
            <div class="ai-tabs">
              <button type="button" class="ai-tab-btn active" data-tab="tab-draft">Chấp bút</button>
              <button type="button" class="ai-tab-btn" data-tab="tab-format">Giàn trang</button>
            </div>

            <!-- Tab 1: Chấp bút -->
            <div class="ai-tab-content active" id="tab-draft">
              <p class="ai-instructions">Hãy phác thảo một vài ý tưởng chính hoặc từ khóa thô của bạn dưới đây. AI sẽ giúp bạn dệt nên bài viết hoàn hảo.</p>
              <div class="form-group-ai">
                <label for="ai-draft-outline">Dàn ý thô</label>
                <textarea id="ai-draft-outline" rows="4" placeholder="Ví dụ:&#10;- Nuôi mèo giúp giảm stress.&#10;- Nghe tiếng gừ gừ (purr) của mèo Muối vào mỗi tối.&#10;- Cảm thấy được ôm ấp vỗ về sau một ngày mệt mỏi ở cơ quan."></textarea>
              </div>
            </div>

            <!-- Tab 2: Biên tập giàn trang -->
            <div class="ai-tab-content" id="tab-format">
              <p class="ai-instructions">AI sẽ tự động đọc bài viết nháp hiện tại của bạn, tiến hành ngắt dòng (tối đa 4 câu/đoạn), định dạng H2/H3, blockquote cảm xúc và gợi ý các vị trí chèn ảnh trực quan.</p>
            </div>

            <!-- Thiết lập Curator Voice trực tiếp trong AI Sheet -->
            <div class="form-group-ai-curator">
              <label for="blog-curator-ai">Giọng văn Curator (Chú mèo đại diện)</label>
              <select id="blog-curator-ai">
                <option value="Tina">Tina (Thông thái, triết lý chữa lành)</option>
                <option value="Latte">Latte (Tinh nghịch, vui vẻ)</option>
                <option value="Muối">Muối (Ấm áp, thủ thỉ tâm sự)</option>
              </select>
            </div>

            <!-- Nút chạy hiệu đính -->
            <button type="button" class="btn-run-ai" id="btn-run-ai-action">
              <span class="btn-text"><i class="ph-light ph-lightning"></i> Bắt đầu hiệu đính</span>
              <span class="btn-loading hidden"><i class="ph-light ph-spinner-gap spin"></i> AI đang viết...</span>
            </button>
          </div>

          <!-- Cột hiển thị kết quả Xem trước -->
          <div class="ai-preview-panel">
            <h4 class="preview-title"><i class="ph-light ph-eye"></i> Bản xem trước kết quả</h4>
            <div class="ai-preview-container" id="ai-result-preview">
              <span class="preview-placeholder">Gợi ý câu chữ và bố cục bài viết hiệu đính từ AI sẽ hiển thị ở đây...</span>
            </div>
            <div class="ai-preview-actions">
              <button type="button" class="btn-apply-ai hidden" id="btn-apply-ai">
                <i class="ph-light ph-check"></i> Áp dụng vào trang soạn thảo
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Scripts tải Tiptap client-side qua ESM -->
<script>
  import { Editor } from 'https://esm.sh/@tiptap/core';
  import StarterKit from 'https://esm.sh/@tiptap/starter-kit';
  import Image from 'https://esm.sh/@tiptap/extension-image';

  document.addEventListener('DOMContentLoaded', () => {
    // Biến lưu trữ ID của bài viết hiện đang soạn thảo (null nếu là bài viết mới)
    let currentBlogId = null;
    let allUserBlogs = []; // Lưu trữ danh sách bài viết để chuyển đổi nhanh

    // 1. Khởi tạo Tiptap Editor
    const editor = new Editor({
      element: document.querySelector('#editor-canvas')!,
      extensions: [
        StarterKit,
        Image.configure({
          allowBase64: true,
          HTMLAttributes: {
            class: 'blog-body-inline-image',
          },
        }),
      ],
      content: '<p>Gõ những suy nghĩ thô mộc của bạn tại đây để bắt đầu câu chuyện...</p>',
      onUpdate({ editor }) {
        updateToolbarState();
      }
    });

    // 2. Toolbar định dạng
    const toolbar = document.getElementById('editor-toolbar')!;
    toolbar.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const action = btn.getAttribute('data-action')!;
        
        if (action === 'bold') editor.chain().focus().toggleBold().run();
        if (action === 'italic') editor.chain().focus().toggleItalic().run();
        if (action === 'h2') editor.chain().focus().toggleHeading({ level: 2 }).run();
        if (action === 'h3') editor.chain().focus().toggleHeading({ level: 3 }).run();
        if (action === 'blockquote') editor.chain().focus().toggleBlockquote().run();
        if (action === 'bulletList') editor.chain().focus().toggleBulletList().run();
        updateToolbarState();
      });
    });

    // Chèn ảnh
    document.getElementById('insert-image-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      const url = prompt('Nhập đường dẫn hình ảnh (Unsplash):', 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=600');
      if (url) {
        editor.chain().focus().setImage({ src: url }).run();
      }
    });

    // Chèn Card sản phẩm affiliate
    document.getElementById('insert-product-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = prompt('Nhập mã định danh sản phẩm (slug, ví dụ: sach-tam-ly-meo):');
      if (slug) {
        editor.chain().focus().insertContent(`<div class="inline-product-card" data-slug="${slug}">[Card Sản Phẩm: ${slug}]</div><p></p>`).run();
      }
    });

    function updateToolbarState() {
      toolbar.querySelectorAll('[data-action]').forEach(btn => {
        const action = btn.getAttribute('data-action')!;
        if (action === 'bold' && editor.isActive('bold')) btn.classList.add('active');
        else if (action === 'italic' && editor.isActive('italic')) btn.classList.add('active');
        else if (action === 'h2' && editor.isActive('heading', { level: 2 })) btn.classList.add('active');
        else if (action === 'h3' && editor.isActive('heading', { level: 3 })) btn.classList.add('active');
        else if (action === 'blockquote' && editor.isActive('blockquote')) btn.classList.add('active');
        else if (action === 'bulletList' && editor.isActive('bulletList')) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    // 3. Drawer Thiết Lập Bài Viết
    const settingsDrawer = document.getElementById('editor-settings-drawer')!;
    const btnToggleSettings = document.getElementById('btn-toggle-settings')!;
    const btnCloseSettings = document.getElementById('btn-close-settings')!;

    btnToggleSettings.addEventListener('click', () => {
      settingsDrawer.classList.toggle('hidden');
    });

    btnCloseSettings.addEventListener('click', () => {
      settingsDrawer.classList.add('hidden');
    });

    // 4. Toggle Left Sidebar
    const btnToggleSidebar = document.getElementById('btn-toggle-sidebar')!;
    const editorContainer = document.getElementById('editor-container')!;

    btnToggleSidebar.addEventListener('click', () => {
      editorContainer.classList.toggle('sidebar-collapsed');
      btnToggleSidebar.classList.toggle('active');
    });

    // 5. Quản lý Bottom Sheet Hiệu Đính AI
    const aiSheet = document.getElementById('ai-bottom-sheet')!;
    const btnOpenAiSheet = document.getElementById('btn-open-ai-sheet')!;
    const btnCloseAiSheet = document.getElementById('ai-sheet-close-btn')!;
    const aiBackdrop = document.getElementById('ai-sheet-backdrop')!;
    
    btnOpenAiSheet.addEventListener('click', () => {
      aiSheet.classList.add('open');
      document.body.style.overflow = 'hidden';
    });

    function closeAiSheet() {
      aiSheet.classList.remove('open');
      document.body.style.overflow = '';
    }

    btnCloseAiSheet.addEventListener('click', closeAiSheet);
    aiBackdrop.addEventListener('click', closeAiSheet);

    // Chuyển đổi tabs AI
    const aiTabs = aiSheet.querySelectorAll('.ai-tab-btn');
    const aiTabContents = aiSheet.querySelectorAll('.ai-tab-content');
    let activeAiMode = 'draft';

    aiTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        aiTabs.forEach(t => t.classList.remove('active'));
        aiTabContents.forEach(c => c.classList.remove('active'));
        
        tab.classList.add('active');
        const targetTab = tab.getAttribute('data-tab')!;
        document.getElementById(targetTab)?.classList.add('active');
        
        activeAiMode = targetTab === 'tab-draft' ? 'draft' : 'format';
      });
    });

    // Gọi API AI
    let latestAiText = '';
    const btnRunAi = document.getElementById('btn-run-ai-action') as HTMLButtonElement;
    const aiPreviewContainer = document.getElementById('ai-result-preview')!;
    const btnApplyAi = document.getElementById('btn-apply-ai')!;

    btnRunAi.addEventListener('click', async () => {
      let contentToProcess = '';
      const curator = (document.getElementById('blog-curator-ai') as HTMLSelectElement).value;

      if (activeAiMode === 'draft') {
        contentToProcess = (document.getElementById('ai-draft-outline') as HTMLTextAreaElement).value.trim();
        if (!contentToProcess) {
          alert('Hãy gõ một vài ý chính để AI chấp bút nhé!');
          return;
        }
      } else {
        contentToProcess = editor.getText().trim();
        if (!contentToProcess || contentToProcess === 'Gõ những suy nghĩ thô mộc của bạn tại đây để bắt đầu câu chuyện...') {
          alert('Hãy viết nháp nội dung blog vào khung soạn thảo trước khi giàn trang nhé!');
          return;
        }
      }

      setLoading(true);
      try {
        const res = await fetch('/api/blog/ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: activeAiMode, content: contentToProcess, curator })
        });
        
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        latestAiText = data.text;
        aiPreviewContainer.innerHTML = convertMarkdownToHtml(latestAiText);
        btnApplyAi.classList.remove('hidden');
      } catch (err: any) {
        alert('Lỗi hiệu đính: ' + err.message);
      } finally {
        setLoading(false);
      }
    });

    btnApplyAi.addEventListener('click', () => {
      if (latestAiText) {
        const html = convertMarkdownToHtml(latestAiText);
        editor.commands.setContent(html);
        closeAiSheet();
      }
    });

    function setLoading(isLoading: boolean) {
      btnRunAi.disabled = isLoading;
      const textSpan = btnRunAi.querySelector('.btn-text');
      const loadingSpan = btnRunAi.querySelector('.btn-loading');
      if (isLoading) {
        textSpan?.classList.add('hidden');
        loadingSpan?.classList.remove('hidden');
      } else {
        textSpan?.classList.remove('hidden');
        loadingSpan?.classList.add('hidden');
      }
    }

    function convertMarkdownToHtml(markdown: string): string {
      return markdown
        .replace(/\n\n/g, '</p><p>')
        .replace(/\n/g, '<br/>')
        .replace(/^#\s+(.+)$/gm, '<h1>$1</h1>')
        .replace(/^##\s+(.+)$/gm, '<h2>$1</h2>')
        .replace(/^###\s+(.+)$/gm, '<h3>$1</h3>')
        .replace(/^\>\s+(.+)$/gm, '<blockquote>$1</blockquote>')
        .replace(/^\*\s+(.+)$/gm, '<ul><li>$1</li></ul>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/^<\/p><p>$/, '');
    }

    // 6. Tải danh sách bài viết của Creator từ Supabase
    async function loadBlogsList() {
      const supabaseClient = (window as any).supabase;
      const listContainer = document.getElementById('sidebar-blog-list')!;
      const userEmailText = document.getElementById('sidebar-user-email')!;

      if (!supabaseClient) {
        listContainer.innerHTML = '<div class="sidebar-error">Lỗi kết nối database</div>';
        return;
      }

      try {
        const { data: { user } } = await supabaseClient.auth.getUser();
        if (!user) {
          listContainer.innerHTML = '<div class="sidebar-error">Vui lòng đăng nhập</div>';
          userEmailText.innerText = 'Chưa đăng nhập';
          return;
        }

        userEmailText.innerText = user.email || 'Creator Account';

        const { data: blogs, error } = await supabaseClient
          .from('creator_blogs')
          .select('id, slug, title, description, content, pillar, category, cover_image, is_published')
          .eq('author_id', user.id)
          .order('updated_at', { ascending: false });

        if (error) throw error;

        allUserBlogs = blogs || [];
        renderSidebarList(allUserBlogs);
      } catch (err: any) {
        listContainer.innerHTML = `<div class="sidebar-error">Lỗi tải danh sách</div>`;
      }
    }

    function renderSidebarList(blogs: any[]) {
      const listContainer = document.getElementById('sidebar-blog-list')!;
      
      if (blogs.length === 0) {
        listContainer.innerHTML = '<div class="sidebar-empty">Chưa viết bài nào 🐾</div>';
        return;
      }

      listContainer.innerHTML = blogs.map(blog => `
        <div class="sidebar-post-item ${blog.id === currentBlogId ? 'active' : ''}" data-id="${blog.id}">
          <i class="ph-light ${blog.is_published ? 'ph-file-text' : 'ph-file-dashed'}"></i>
          <div class="post-item-info">
            <span class="post-item-title">${blog.title || 'Không tiêu đề'}</span>
            <span class="post-item-badge ${blog.is_published ? 'published' : 'draft'}">
              ${blog.is_published ? 'Đã đăng' : 'Bản nháp'}
            </span>
          </div>
        </div>
      `).join('');

      // Add click listeners to items
      listContainer.querySelectorAll('.sidebar-post-item').forEach(item => {
        item.addEventListener('click', () => {
          const blogId = item.getAttribute('data-id')!;
          loadBlogIntoEditor(blogId);
        });
      });
    }

    // Nạp dữ liệu bài viết được click vào editor
    function loadBlogIntoEditor(blogId: string) {
      const blog = allUserBlogs.find(b => b.id === blogId);
      if (!blog) return;

      currentBlogId = blog.id;
      
      // Cập nhật tiêu đề & nội dung editor
      (document.getElementById('blog-title') as HTMLInputElement).value = blog.title;
      editor.commands.setContent(blog.content);

      // Cập nhật metadata drawer
      (document.getElementById('blog-desc') as HTMLTextAreaElement).value = blog.description || '';
      (document.getElementById('blog-category') as HTMLSelectElement).value = blog.category || 'vat_pham';
      (document.getElementById('blog-pillar') as HTMLSelectElement).value = blog.pillar || 'nhip_tho';
      (document.getElementById('blog-cover') as HTMLInputElement).value = blog.cover_image || '';

      // Đánh dấu active trong sidebar
      document.querySelectorAll('.sidebar-post-item').forEach(item => {
        if (item.getAttribute('data-id') === blogId) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    // Reset editor để tạo bài viết mới
    const btnNewPost = document.getElementById('btn-new-post-sidebar')!;
    btnNewPost.addEventListener('click', () => {
      currentBlogId = null;
      (document.getElementById('blog-title') as HTMLInputElement).value = '';
      editor.commands.setContent('<p>Gõ những suy nghĩ thô mộc của bạn tại đây để bắt đầu câu chuyện...</p>');
      
      // Reset metadata fields
      (document.getElementById('blog-desc') as HTMLTextAreaElement).value = '';
      (document.getElementById('blog-category') as HTMLSelectElement).value = 'vat_pham';
      (document.getElementById('blog-pillar') as HTMLSelectElement).value = 'nhip_tho';
      (document.getElementById('blog-cover') as HTMLInputElement).value = '';

      // Gỡ bỏ active trong sidebar
      document.querySelectorAll('.sidebar-post-item').forEach(item => item.classList.remove('active'));
    });

    // Gọi load danh sách bài viết ban đầu
    loadBlogsList();

    // 7. Lưu và xuất bản tích hợp cập nhật danh sách
    const btnSaveDraft = document.getElementById('btn-save-draft')!;
    const btnPublishMain = document.getElementById('btn-publish-main')!;

    btnSaveDraft.addEventListener('click', () => saveBlog(false));
    btnPublishMain.addEventListener('click', () => saveBlog(true));

    async function saveBlog(isPublish: boolean) {
      const title = (document.getElementById('blog-title') as HTMLInputElement).value.trim();
      const description = (document.getElementById('blog-desc') as HTMLTextAreaElement).value.trim();
      const coverImage = (document.getElementById('blog-cover') as HTMLInputElement).value.trim();
      const category = (document.getElementById('blog-category') as HTMLSelectElement).value;
      const pillar = (document.getElementById('blog-pillar') as HTMLSelectElement).value;
      const content = editor.getJSON();

      if (!title || title === 'Tiêu đề bài viết...') {
        alert('Hãy gõ một tiêu đề thật ấm áp trước nhé!');
        return;
      }

      const slug = title.toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/đ/g, "d").replace(/Đ/g, "d")
        .replace(/[^a-z0-9\s-]/g, "")
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-");

      const supabaseClient = (window as any).supabase;
      if (!supabaseClient) {
        alert('Lỗi: Supabase Client chưa được kết nối!');
        return;
      }

      const { data: { user } } = await supabaseClient.auth.getUser();
      if (!user) {
        alert('Vui lòng đăng nhập để lưu trữ bài viết!');
        return;
      }

      const payload: any = {
        author_id: user.id,
        slug,
        title,
        description: description || 'Mẩu chuyện nhỏ viết bởi người thương Doca.',
        cover_image: coverImage || 'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=800',
        content,
        pillar,
        category,
        is_published: isPublish,
        updated_at: new Date().toISOString()
      };

      // Nếu đang chỉnh sửa bài viết đã có, đính kèm ID để update thay vì tạo mới
      if (currentBlogId) {
        payload.id = currentBlogId;
      }

      try {
        const { data, error } = await supabaseClient
          .from('creator_blogs')
          .upsert(payload, { onConflict: 'slug' })
          .select();

        if (error) throw error;
        
        if (data && data[0]) {
          currentBlogId = data[0].id;
        }

        alert(isPublish ? 'Chúc mừng! Bài viết đã được đăng lên Doca Pet! 🐾' : 'Đã lưu trữ bản nháp thành công! ✍️');
        
        // Tải lại danh sách thanh bên để cập nhật trạng thái
        loadBlogsList();
      } catch (err: any) {
        alert('Không thể lưu: ' + err.message);
      }
    }
  });
</script>

