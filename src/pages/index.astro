  @media (min-width: 1024px) {
    .blog-section .container {
      max-width: 1280px !important;
    }
    .blog-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.1rem; /* Thu hẹp từ 2rem */
      max-width: 100% !important;
      margin: 0 auto;
    }
  }

  .blog-view-more-container {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .blog-desc-bottom {
    text-align: center;
    font-size: 0.92rem;
    color: #8E8E93;
    max-width: 600px;
    margin: 2.5rem auto 0;
    line-height: 1.6;
    padding: 0 1rem;
  }

  .blog-view-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--cozy-text-obsidian);
    color: #FFFFFF;
    padding: 0.65rem 1.75rem;
    border-radius: 24px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
