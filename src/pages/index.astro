<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- 0. HOMEPAGE BLOG PILLAR TABS FILTER ---
    const blogTabButtons = document.querySelectorAll('.blog-section .tab-btn');
    const blogListItems = document.querySelectorAll('.blog-section .blog-item');

    blogTabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active class
        blogTabButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedPillar = btn.getAttribute('data-pillar');
        let visibleCount = 0;

        blogListItems.forEach((item: any) => {
          const itemPillar = item.getAttribute('data-pillar');
          if (selectedPillar === 'all' || itemPillar === selectedPillar) {
            if (visibleCount < 6) {
              item.style.display = 'flex';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // --- HAMBURGER MENU TOGGLE ---
    const menuToggleBtn = document.getElementById('menu-toggle-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');

    const closeMobileMenu = () => {
      if (mobileMenu?.classList.contains('active')) {
        menuToggleBtn?.setAttribute('aria-expanded', 'false');
        menuToggleBtn?.classList.remove('active');
        mobileMenu?.classList.remove('active');
      }
    };

    menuToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
      menuToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menuToggleBtn.classList.toggle('active');
      mobileMenu?.classList.toggle('active');
    });

    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    });

    document.addEventListener('touchstart', (e) => {
      const target = e.target as HTMLElement;
      if (!menuToggleBtn?.contains(target) && !mobileMenu?.contains(target)) {
        closeMobileMenu();
      }
    }, { passive: true });

    window.addEventListener('scroll', () => {
      closeMobileMenu();
    }, { passive: true });

    // --- 1. COZY MUSIC PLAYER HANDLER (DOCA FM RADIO SYNCED) ---
    const audio = document.getElementById('cozy-audio-player') as HTMLAudioElement;
    const playBtn = document.querySelector('.player-control-btn');
    const playerWrapper = document.querySelector('.cozy-player-wrapper');
    const playerContainer = document.querySelector('.cozy-music-player');
    const playerTitle = document.querySelector('.player-title');
    const playerStatus = document.querySelector('.player-status');
    const playIcon = document.querySelector('.play-icon');
    const pauseIcon = document.querySelector('.pause-icon');
    const playlistToggleBtn = document.querySelector('.player-playlist-toggle-btn');

    // Mini player header elements
    const miniPlayerPill = document.getElementById('mini-player-pill');
    const miniPlayIcon = document.querySelector('.mini-play-icon');
    const miniPauseIcon = document.querySelector('.mini-pause-icon');

    let fmPlaylist = [];
    let totalPlaylistDuration = 0;
    let isPlaylistLoaded = false;
    let isDirectPlay = false;
    let activeTrackIndex = 0;

    const fallbackPlaylists = {};
    for (let d = 0; d < 7; d++) {
      (fallbackPlaylists as any)[d.toString()] = {
        "morning": { title: `Nắng Sớm Bên Hiên (Thứ ${d===0?'Chủ Nhật':d+1}) ☕`, story_title: "Tách Trà Sớm Và Tiếng Đuôi Gõ Nhịp", story: "Mở đầu ngày mới bên tách trà sớm ấm áp và ngọt lành của bé cưng.", intro: "Chào cô/chú nhé! Sớm hôm nay ở Bình Hưng thật [thời tiết] đúng không? Tina đã dọn sẵn đĩa nhạc...", tracks: ["tina_morning_01"] },
        "afternoon": { title: `Góc Khuất Bình Yên (Thứ ${d===0?'Chủ Nhật':d+1}) 🍃`, story_title: "Nắng Trưa Đậu Trên Bộ Lông Khô Ráo", story: "Góc nằm lười trưa nắng bên cửa sổ đón ngọn gió mát lành.", intro: "Tina chào cả nhà nhé! Tiết trời trưa nay Bình Hưng đang [thời tiết], cùng nghe nhạc thư giãn nhé...", tracks: ["tina_afternoon_01"] },
        "evening": { title: `Đèn Vàng Vĩ Tuyến (Thứ ${d===0?'Chủ Nhật':d+1}) 🌙`, story_title: "Đèn Đêm Vàng Và Giấc Mộng Màu Xanh", story: "Ánh đèn đêm ấm áp vang lên bản jazz êm đềm xoa dịu những nhọc nhằn.", intro: "cô/chú ơi, buổi tối Bình Hưng có chút [thời tiết] rồi đấy, gác lại âu lo và nằm xuống thôi...", tracks: ["tina_evening_01"] }
      };
    }

    async function fetchWeather() {
      // Check sessionStorage cache first (30 mins duration)
      try {
        const cachedData = sessionStorage.getItem('doca_weather_info');
        const cachedTime = sessionStorage.getItem('doca_weather_time');
        const now = Date.now();
        if (cachedData && cachedTime && (now - parseInt(cachedTime, 10)) < 1800000) {
          return JSON.parse(cachedData);
        }
      } catch (e) {}

      const url = "https://api.open-meteo.com/v1/forecast?latitude=10.7222&longitude=106.6783&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min,weather_code&timezone=Asia%2FSingapore";
      const controller = new AbortController();
      const id = setTimeout(() => controller.abort(), 1500);
      try {
        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(id);
        if (res.ok) {
          const data = await res.json();
          if (data && data.current && data.daily) {
            const currentTemp = Math.round(data.current.temperature_2m);
            const currentCode = data.current.weather_code;
            const minTemp = Math.round(data.daily.temperature_2m_min[0]);
            const maxTemp = Math.round(data.daily.temperature_2m_max[0]);
            const dailyCode = data.daily.weather_code[0];

            const weatherInfo = {
              temp: currentTemp,
              minTemp: minTemp,
              maxTemp: maxTemp,
              currentCode: currentCode,
              dailyCode: dailyCode,
              description: mapWeatherCode(currentCode)
            };
            
            try {
              sessionStorage.setItem('doca_weather_info', JSON.stringify(weatherInfo));
              sessionStorage.setItem('doca_weather_time', Date.now().toString());
            } catch (e) {}

            return weatherInfo;
          }
        }
      } catch (err) {
        console.warn("Weather fetch failed or timed out, using fallback", err);
      }
      return { temp: 28, minTemp: 24, maxTemp: 32, currentCode: 1, dailyCode: 3, description: "trời mát mẻ" };
    }

    function mapWeatherCode(code: number) {
      if (code === 0) return "trời trong xanh";
      if ([1, 2, 3].includes(code)) return "mây nhẹ mát mẻ";
      if ([45, 48].includes(code)) return "sương mù nhẹ";
      if ([51, 53, 55].includes(code)) return "mưa phùn nhè nhẹ";
      if ([61, 63, 65].includes(code)) return "mưa rào";
      if ([71, 73, 75].includes(code)) return "lạnh dịu";
      if ([80, 81, 82].includes(code)) return "mưa giông";
      if ([95, 96, 99].includes(code)) return "giông bão";
      return "mát mẻ";
    }
    function initPlaylist(tracksList: any[], playlistsConfig: any, weather: any) {
      const now = new Date();
      const today = now.getDay();
      
      const hour = now.getHours();
      let activeSlot = "evening";
      if (hour >= 6 && hour < 12) {
        activeSlot = "morning";
      } else if (hour >= 12 && hour < 18) {
        activeSlot = "afternoon";
      }
      
      const dayPlaylistConfig = playlistsConfig[today.toString()] || playlistsConfig["0"];
      const todayPlaylist = dayPlaylistConfig[activeSlot];
      
      const vibeBadge = document.getElementById('host-vibe-badge');
      const introText = document.getElementById('host-intro-text');
      const storyTitle = document.getElementById('host-story-title');
      const storyText = document.getElementById('host-story-text');
      
      if (vibeBadge) vibeBadge.textContent = todayPlaylist.title;
      if (storyTitle) storyTitle.textContent = todayPlaylist.story_title || "Lý do lựa chọn playlist";
      if (storyText) storyText.textContent = todayPlaylist.story;
      
      const getPoeticDayType = (d: number, selection: number) => {
        const pools: Record<number, string[]> = {
          0: ["chủ nhật bình yên", "ngày cuối tuần thảnh thơi"],
          1: ["ngày đầu tuần êm ả", "thứ hai dịu nhẹ"],
          2: ["ngày thứ ba lững lờ", "buổi chiều thứ ba tĩnh lặng"],
          3: ["thứ tư dịu ngọt", "ngày giữa tuần bình yên"],
          4: ["thứ năm lặng lẽ", "ngày thường êm ả"],
          5: ["thứ sáu tự do", "ngày cận cuối tuần thong thả"],
          6: ["thứ bảy ngọt ngào", "ngày cuối tuần dịu dàng"]
        };
        const pool = pools[d] || ["ngày thường bình yên"];
        return pool[selection % pool.length];
      };

      const monthNames = ["tháng Giêng", "tháng Hai", "tháng Ba", "tháng Tư", "tháng Năm", "tháng Sáu", "tháng Bảy", "tháng Tám", "tháng Chín", "tháng Mười", "tháng Mười Một", "tháng Chạp"];
      const currentMonth = monthNames[now.getMonth()];
      
      // Construct dynamic weather commentary
      let weatherText = "";
      const isCurrentlyRain = [51, 53, 55, 61, 63, 65, 80, 81, 82].includes(weather.currentCode);
      const isDailyRain = [51, 53, 55, 61, 63, 65, 80, 81, 82].includes(weather.dailyCode);
      const tempRange = weather.maxTemp - weather.minTemp;
      const isHot = weather.temp >= 31;
      const isCold = weather.temp <= 24;

      // Select index based on day and current minute to ensure variety
      const selectionIdx = (now.getMinutes() + today);

      if (!isCurrentlyRain && isDailyRain) {
        const pool = [
          "trời se lạnh và xám mây. Lòng tự dưng muốn cuộn tròn bên bé cưng ngắm mưa lác đác sắp về... ☔",
          "se lạnh và mây xám kéo về nhiều rồi. Giữa nốt nhạc trầm ấm bỗng thấy lòng thật tĩnh tại... 🌧️"
        ];
        weatherText = pool[selectionIdx % pool.length];
      } else if (isCurrentlyRain) {
        const pool = [
          "mưa rơi tí tách ngoài hiên. Trong căn phòng ấm áp, nghe tiếng jazz thấy bình yên vô cùng... 🕯️",
          "mưa trút mát rượi. Cô/chú trốn mưa cuộn tròn nghe những nốt nhạc ngọt ngào này nhé... 🐾"
        ];
        weatherText = pool[selectionIdx % pool.length];
      } else if (tempRange >= 6) {
        const pool = [
          "nắng nhẹ nhưng se se gió. Giai điệu dịu ngọt này sẽ giữ cho tâm hồn cả nhà thật ấm áp... 🐾",
          "hiu hiu gió mát. Đêm về trời sẽ lạnh hơn đấy, để tiếng kèn ngọt ngào ôm lấy cô/chú và bé cưng nhé... 🛌"
        ];
        weatherText = pool[selectionIdx % pool.length];
      } else if (isHot) {
        const pool = [
          "nắng vàng rực rỡ ngoài ô cửa. Hãy tận hưởng làn gió mát cùng giai điệu thong thả này nhé... 🍃",
          "trưa nắng oi ả, lòng chỉ muốn ghé lại góc quen, tìm chút thanh âm dịu mát tâm hồn... 🥛"
        ];
        weatherText = pool[selectionIdx % pool.length];
      } else if (isCold) {
        const pool = [
          "se se lạnh dễ chịu ghê. Cuộn tròn cùng bé cưng nghe bản nhạc ấm áp này thì thật tuyệt... 🐾",
          "lành lạnh mát mẻ. Bé cưng đã rúc sâu vào chiếc chăn ấm, khẽ gõ đuôi theo tiếng nhạc rồi kìa... 🛌"
        ];
        weatherText = pool[selectionIdx % pool.length];
      } else {
        const pool = [
          "dịu mát, trong lành vô cùng. Một tách trà ấm và tiếng jazz êm dịu là đủ cho một ngày bình yên... 🍵",
          "những cơn gió thoảng qua thật dễ chịu. Nghe tiếng nhạc ngân nga, lòng nhẹ bẫng đi bao nhiêu... 🎶"
        ];
        weatherText = pool[selectionIdx % pool.length];
      }

      const poeticDay = getPoeticDayType(today, selectionIdx);
      let finalIntro = "";

      if (activeSlot === "morning") {
        const pool = [
          `Chào cô/chú nhé! Sớm mai ${weatherText} Khởi đầu ngày ${poeticDay} thật thảnh thơi bên ly cà phê ấm và giai điệu dịu ngọt đầu ngày nhé... ☕`,
          `Chào cả nhà! Nắng sớm ghé hiên rồi, ${weatherText} Giữa những ngày ${currentMonth} thế này, cùng bé cưng cuộn tròn lười biếng một chút bên bản jazz mộc mạc, cô/chú nhỉ... 🐾`
        ];
        finalIntro = pool[selectionIdx % pool.length];
      } else if (activeSlot === "afternoon") {
        const pool = [
          `Tina chào cả nhà nhé! Trưa nay ${weatherText} Giữa ngày ${poeticDay} êm ả, cô/chú đã nghỉ ngơi chưa nhỉ? Ghé lại đây thả trôi mệt mỏi cùng giai điệu bình yên này nha... 🍃`,
          `cô/chú ơi, không khí trưa nay ${weatherText} Một buổi trưa ${poeticDay} thật thong thả, hãy để những giai điệu êm đềm này xoa dịu và ôm ấp tâm hồn cô/chú nhé... 🐾`
        ];
        finalIntro = pool[selectionIdx % pool.length];
      } else {
        const pool = [
          `cô/chú ơi, bóng tối dịu dàng buông xuống rồi. Đêm nay trời ${weatherText} Gác lại mọi lo toan bên ngoài ô cửa, đắp chăn ấm cho bé cưng và cùng ngủ một giấc thật ngon nha... 🌙`,
          `Đêm nay ${weatherText} Khép lại một ngày ${poeticDay} nhẹ nhàng, cùng tắt bớt đèn và chìm vào không gian ấm áp bình yên này thôi nào... 🕯️`
        ];
        finalIntro = pool[selectionIdx % pool.length];
      }
        
      if (introText) introText.textContent = finalIntro;
      

      
      fmPlaylist = [];
      totalPlaylistDuration = 0;
      
      todayPlaylist.tracks.forEach((trackId: string) => {
        const track = tracksList.find(t => t.id === trackId);
        if (track) {
          const start = totalPlaylistDuration;
          totalPlaylistDuration += track.duration;
          fmPlaylist.push({
            title: track.title,
            artist: track.artist,
            url: track.url,
            start: start,
            duration: track.duration
          });
        }
      });
      
      const playlistUl = document.getElementById('playlist-tracks-ul');
      if (playlistUl) {
        playlistUl.innerHTML = fmPlaylist.map((track, idx) => {
          const minutes = Math.floor(track.duration / 60);
          const seconds = track.duration % 60;
          const durationStr = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
          const numStr = (idx + 1) < 10 ? `0${idx + 1}` : `${idx + 1}`;
          return `
            <li class="track-item" style="cursor: pointer;">
              <span class="track-num">${numStr}</span>
              <span class="track-name-text">${track.title} - <span class="track-artist" style="opacity: 0.7; font-size: 0.9em;">${track.artist}</span></span>
              <div class="mini-wave">
                <span class="mini-bar"></span>
                <span class="mini-bar"></span>
                <span class="mini-bar"></span>
              </div>
              <span class="track-duration" style="font-size: 0.75rem; opacity: 0.5; display: flex; align-items: center; gap: 4px;">
                <i class="ph-light ph-radio"></i> ${durationStr}
              </span>
            </li>
          `;
        }).join('');

        // Thêm sự kiện click mở Bottom Sheet giải thích tính năng Live FM
        setTimeout(() => {
          const trackItems = playlistUl.querySelectorAll('.track-item');
          const fmInfoSheet = document.getElementById('fm-info-sheet');
          trackItems.forEach(item => {
            item.addEventListener('click', (e) => {
              e.stopPropagation();
              fmInfoSheet?.classList.add('active');
            });
          });
        }, 100);
      }
    }

    async function loadPlaylist() {
      const weather = await fetchWeather();
      const r2Domain = (window as any).PUBLIC_R2_PUBLIC_DOMAIN || import.meta.env.PUBLIC_R2_PUBLIC_DOMAIN || 'https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev';
      
      // Helper function to process data and initialize playlist
      function setupPlaylistData(data: any) {
        if (data && data.tracks && data.playlists) {
          const normalizedTracks = data.tracks.map((track: any) => {
            if (track.url && !track.url.startsWith('http://') && !track.url.startsWith('https://')) {
              const relativeUrl = track.url.startsWith('/') ? track.url : `/${track.url}`;
              return { ...track, url: `${r2Domain.replace(/\/$/, '')}${relativeUrl}` };
            }
            return track;
          });
          initPlaylist(normalizedTracks, data.playlists, weather);
          isPlaylistLoaded = true;
          return true;
        }
        return false;
      }

      // 1. Thử tải từ đường dẫn tương đối gốc /playlist.json (Tránh CORS lỗi trên Local và Prod)
      try {
        const res = await fetch('/playlist.json');
        if (res.ok) {
          const data = await res.json();
          if (setupPlaylistData(data)) {
            console.log("Successfully loaded playlist.json from local relative path");
            return;
          }
        }
      } catch (err) {
        console.warn("Failed to load playlist.json from relative path, trying CDN...", err);
      }

      // 2. Dự phòng 1: Tải trực tiếp từ Cloudflare R2 CDN URL
      if (r2Domain) {
        const r2PlaylistUrl = `${r2Domain.replace(/\/$/, '')}/playlist.json`;
        try {
          const res = await fetch(r2PlaylistUrl);
          if (res.ok) {
            const data = await res.json();
            if (setupPlaylistData(data)) {
              console.log("Successfully loaded playlist.json from R2 CDN URL");
              return;
            }
          }
        } catch (err) {
          console.warn("Failed to load playlist.json from Cloudflare R2 CDN", err);
        }
      }

      // 3. Dự phòng 2: Offline hoàn toàn
      const fallbackTracks = [
        { id: "tina_morning_01", title: "New Day Waltz ☕", artist: "Tina's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/Morning%20Tea%20%26%20Cake%20%E2%98%95%201940s%20Vintage%20Cafe%20Ambience%20%E2%80%93%20A%20Sweet%20%26%20Peaceful%20Corner%20for%20You/New%20Day%20Waltz.mp3", duration: 194 },
        { id: "tina_afternoon_01", title: "Cozy Garden 🌿", artist: "Latte's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/Morning%20Tea%20%26%20Cake%20%E2%98%95%201940s%20Vintage%20Cafe%20Ambience%20%E2%80%93%20A%20Sweet%20%26%20Peaceful%20Corner%20for%20You/Cozy%20Garden.mp3", duration: 180 },
        { id: "tina_evening_01", title: "My Late Night Monologue 🌙", artist: "Muối's Cozy Song", url: "https://pub-0da307f5970748e8a0109943d1f10cb0.r2.dev/tracks/1940s%20VINTAGE%20CAFE%20AMBIENCE%20-%20A%20LITTLE%20CALM%20FOR%20YOU%20TODAY/My%20Late%20Night%20Monologue.mp3", duration: 217 }
      ];
      initPlaylist(fallbackTracks, fallbackPlaylists, weather);
    }

    // Load initial playlist
    loadPlaylist();

    // Toggle Playlist Expand/Collapse
    playlistToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      playerWrapper?.classList.toggle('expanded');
      
      // Track GA4 event when expanded
      if (playerWrapper?.classList.contains('expanded')) {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'expand_playlist_dropdown', {
            playlist_name: 'Doca FM Radio'
          });
        }
      }
    });

    // Close playlist if clicked outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!playerWrapper?.contains(target)) {
        playerWrapper?.classList.remove('expanded');
      }
    });

    function getSyncedTrack() {
      const nowInSeconds = Math.floor(Date.now() / 1000);
      if (totalPlaylistDuration === 0 || fmPlaylist.length === 0) {
        return {
          track: { title: "Doca FM 📻", artist: "Đang kết nối...", url: "", duration: 180 },
          globalOffset: 0,
          trackOffset: 0,
          index: 0
        };
      }
      const playlistOffset = nowInSeconds % totalPlaylistDuration;
      
      for (let i = 0; i < fmPlaylist.length; i++) {
        const track = fmPlaylist[i];
        const end = track.start + track.duration;
        if (playlistOffset >= track.start && playlistOffset < end) {
          const trackOffset = playlistOffset - track.start;
          return {
            track: track,
            globalOffset: playlistOffset,
            trackOffset: trackOffset,
            index: i
          };
        }
      }
      return {
        track: fmPlaylist[0],
        globalOffset: 0,
        trackOffset: 0,
        index: 0
      };
    }

    function syncPlaylistUI(activeTrackIdx: number, isPlaying: boolean) {
      const trackItems = document.querySelectorAll('.track-item');
      trackItems.forEach((item, idx) => {
        if (idx === activeTrackIdx) {
          item.classList.add('active-track-item');
          if (isPlaying) {
            item.classList.add('playing-state');
          } else {
            item.classList.remove('playing-state');
          }
        } else {
          item.classList.remove('active-track-item');
          item.classList.remove('playing-state');
        }
      });
    }

    function updatePlayerUI(isPlaying: boolean, trackTitle: string = "Doca FM Trực Tuyến 📻", activeTrackIdx: number = 0) {
      if (isPlaying) {
        playerContainer?.classList.add('playing');
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
        if (playerTitle) playerTitle.textContent = `📻 FM: ${trackTitle}`;
        
        // Mini player updates
        miniPlayerPill?.classList.add('playing');
        miniPlayIcon?.classList.add('hidden');
        miniPauseIcon?.classList.remove('hidden');
        
        syncPlaylistUI(activeTrackIdx, true);
      } else {
        playerContainer?.classList.remove('playing');
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
        if (playerTitle) playerTitle.textContent = "Doca FM Trực Tuyến 📻";
        if (playerStatus) playerStatus.textContent = "Đang tạm dừng...";
        
        // Mini player updates
        miniPlayerPill?.classList.remove('playing');
        miniPlayIcon?.classList.remove('hidden');
        miniPauseIcon?.classList.add('hidden');
        
        // Remove anim wave from active track
        const activeItem = document.querySelector('.track-item.active-track-item');
        activeItem?.classList.remove('playing-state');
      }
    }

    let prevActiveTrackIndex = -1;
    let prevPlayingState = false;

    function playTrackDirectly(index: number) {
      isDirectPlay = true;
      activeTrackIndex = index;
      playSyncedRadio();
    }

    function playSyncedRadio() {
      if (!audio || fmPlaylist.length === 0) return;
      
      let track, trackOffset, index;
      if (isDirectPlay) {
        track = fmPlaylist[activeTrackIndex];
        trackOffset = 0;
        index = activeTrackIndex;
      } else {
        const synced = getSyncedTrack();
        track = synced.track;
        trackOffset = synced.trackOffset;
        index = synced.index;
      }
      
      const onMetadataLoaded = () => {
        audio.currentTime = trackOffset;
        audio.play().then(() => {
          updatePlayerUI(true, track.title, index);
          
          // Track GA4 event
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'play_fm_radio', {
              playlist_name: 'Doca FM Radio',
              track_title: track.title,
              is_direct: isDirectPlay
            });
          }
          
          // Reset state tracker variables
          prevActiveTrackIndex = -1;
          prevPlayingState = false;

          const updateStatus = () => {
            if (!audio.paused) {
              const currentPlayTime = audio.currentTime;
              const minutes = Math.floor(currentPlayTime / 60);
              const seconds = Math.floor(currentPlayTime) % 60;
              const timeStr = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
              
              const totalMins = Math.floor(track.duration / 60);
              const totalSecs = track.duration % 60;
              const totalStr = `${totalMins}:${totalSecs < 10 ? '0' : ''}${totalSecs}`;
              
              if (playerStatus) playerStatus.textContent = `Đang phát (${timeStr} / ${totalStr})`;
              
              requestAnimationFrame(updateStatus);
            }
          };
          requestAnimationFrame(updateStatus);
        }).catch(err => {
          console.warn("Audio play failed after metadata:", err);
          updatePlayerUI(false);
        });
      };
      
      // Update audio source if changed
      const currentSrc = audio.getAttribute('src');
      if (currentSrc !== track.url) {
        audio.setAttribute('src', track.url);
        // Wait for metadata to load before playing
        audio.addEventListener('loadedmetadata', onMetadataLoaded, { once: true });
      } else {
        audio.currentTime = trackOffset;
        audio.play().then(() => {
          updatePlayerUI(true, track.title, index);
          
          const updateStatus = () => {
            if (!audio.paused) {
              const currentPlayTime = audio.currentTime;
              const minutes = Math.floor(currentPlayTime / 60);
              const seconds = Math.floor(currentPlayTime) % 60;
              const timeStr = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
              
              const totalMins = Math.floor(track.duration / 60);
              const totalSecs = track.duration % 60;
              const totalStr = `${totalMins}:${totalSecs < 10 ? '0' : ''}${totalSecs}`;
              
              if (playerStatus) playerStatus.textContent = `Đang phát (${timeStr} / ${totalStr})`;
              
              requestAnimationFrame(updateStatus);
            }
          };
          requestAnimationFrame(updateStatus);
        }).catch(err => {
          console.warn("Audio play failed:", err);
          updatePlayerUI(false);
        });
      }
    }

    playBtn?.addEventListener('click', () => {
      if (!audio) return;
      if (audio.paused) {
        isDirectPlay = false; // Reset to FM radio sync on main play click
        playSyncedRadio();
      } else {
        audio.pause();
        updatePlayerUI(false);
        
        // Track GA4 event
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'pause_fm_radio');
        }
      }
    });

    playerContainer?.addEventListener('click', (e) => {
      if (!audio) return;
      if (!audio.paused) return;
      
      const target = e.target as HTMLElement;
      if (target.closest('.player-playlist-toggle-btn') || target.closest('.player-control-btn')) {
        return;
      }
      
      playSyncedRadio();
    });

    audio?.addEventListener('ended', () => {
      if (isDirectPlay) {
        activeTrackIndex = (activeTrackIndex + 1) % fmPlaylist.length;
        playSyncedRadio();
      } else {
        playSyncedRadio();
      }
    });

    // Spotify fake door link
    const spotifyFooterLink = document.querySelector('.playlist-spotify-link-footer');
    spotifyFooterLink?.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Show cozy message in Boss perspective using unified global toast
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast("Đài của tụi con đang chờ bên Spotify duyệt ạ... Cô/chú nghe tạm chiếc radio gỗ này nha? 🐾");
      }
      
      // Track custom event in localStorage for later GA4 sync or debugging
      const fakeDoorClicks = parseInt(localStorage.getItem('fakedoor_spotify_clicks') || '0', 10);
      localStorage.setItem('fakedoor_spotify_clicks', (fakeDoorClicks + 1).toString());
      
      // If GA4 is active, send event
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'click_fake_spotify_link', {
          event_category: 'engagement',
          event_label: 'Spotify Playlist Fake Door'
        });
      }
    });

    // Mini player pill body click handler (toggles play/pause)
    miniPlayerPill?.addEventListener('click', () => {
      if (!audio) return;
      if (audio.paused) {
        playSyncedRadio();
      } else {
        audio.pause();
        updatePlayerUI(false);
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'pause_fm_radio', { source: 'mini_player' });
        }
      }
    });

    // Scroll listener to show/hide the mini player pill on header
    if (miniPlayerPill && playerContainer) {
      window.addEventListener('scroll', () => {
        const rect = playerContainer.getBoundingClientRect();
        // Visible if the main player container bottom goes past the top edge of screen
        if (rect.bottom < 0) {
          miniPlayerPill.classList.add('visible');
        } else {
          miniPlayerPill.classList.remove('visible');
        }
      }, { passive: true });
    }

    // Kệ quà của mẹ không còn tab lọc ở trang chủ nữa, hiển thị mặc định toàn bộ 8 sản phẩm tinh tuyển.

    // --- KIOSK BANNER CLICK HANDLER ---
    const kioskBannerTrigger = document.getElementById('kiosk-banner-trigger');
    if (kioskBannerTrigger) {
      kioskBannerTrigger.addEventListener('click', async (e) => {
        e.preventDefault();
        const { getSupabase, loginWithGoogle } = await import('../scripts/supabase');
        const client = getSupabase();
        if (!client) {
          window.location.href = '/profile';
          return;
        }

        const { data: { session } } = await client.auth.getSession();
        if (session?.user) {
          window.location.href = '/profile';
        } else {
          localStorage.setItem('auth_redirect_origin', window.location.origin + '/profile');
          await loginWithGoogle();
        }
      });
    }

    // --- BOTTOM SHEET EVENT HANDLERS ---
    const fmInfoSheet = document.getElementById('fm-info-sheet');
    const fmSheetClose = document.getElementById('fm-sheet-close');
    fmSheetClose?.addEventListener('click', () => {
      fmInfoSheet?.classList.remove('active');
    });
    fmInfoSheet?.addEventListener('click', (e) => {
      if (e.target === fmInfoSheet) {
        fmInfoSheet.classList.remove('active');
      }
    });
  });
</script>
