      justify-content: center;
      overflow-x: visible;
      padding-bottom: 0;
    }
  }

  .tab-btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cozy-text-obsidian);
    background-color: var(--cozy-bg-pure);
    border: 1px solid var(--cozy-border-light);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    cursor: pointer;
