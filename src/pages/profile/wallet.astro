---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ví Cá & Nạp Tiền | DOCA" description="Quản lý số dư cá và nạp cá trực tuyến qua ZaloPay/MoMo.">
  <main class="wallet-view">
    <div class="wallet-page-container">
      <!-- Nút quay lại Profile -->
      <div class="wallet-nav-header">
        <a href="/profile" class="back-link"><i class="ph-light ph-arrow-left"></i> Trở về Hồ sơ</a>
      </div>

      <!-- Tab điều hướng -->
      <div class="wallet-tabs">
        <button class="wallet-tab-btn active" id="tab-recharge-btn">Nạp Cá <i class="ph-light ph-plus-circle"></i></button>
        <button class="wallet-tab-btn" id="tab-history-btn">Lịch Sử Giao Dịch <i class="ph-light ph-clock-counter-clockwise"></i></button>
      </div>

      <!-- VÙNG 1: NẠP CÁ -->
      <div class="wallet-content-section" id="section-recharge">
        <div class="wallet-balance-card">
          <div class="balance-title">Số dư hiện tại của bạn</div>
          <div class="balance-value" id="current-balance">... Cá</div>
        </div>

        <h2 class="section-title">Chọn gói nạp cá</h2>
        <div class="packages-grid" id="packages-container">
          <div class="loading-placeholder text-center">
            <i class="ph-light ph-spinner-gap spin" style="font-size: 1.5rem; color: var(--cozy-green-matcha-forest);"></i>
            <p class="whisper-mono" style="font-size: 0.8rem; margin-top: 0.5rem;">Đang tải các gói nạp...</p>
          </div>
        </div>

        <!-- Trình chọn cổng thanh toán -->
        <!-- Bottom Sheet Chọn phương thức thanh toán -->
        <div class="cozy-bottom-sheet-overlay hidden" id="payment-sheet-overlay">
          <div class="cozy-bottom-sheet" id="payment-sheet">
            <div class="sheet-header">
              <div class="sheet-handle"></div>
              <h3 class="sheet-title">Xác nhận nạp cá</h3>
              <button class="sheet-close-btn" id="sheet-close-btn" aria-label="Đóng"><i class="ph-light ph-x"></i></button>
            </div>
            
            <div class="sheet-body">
              <!-- Thông tin gói đã chọn -->
              <div class="selected-package-summary">
                <div class="summary-left">
                  <div class="summary-name" id="selected-pkg-name">Gói Cá...</div>
                  <div class="summary-desc" id="selected-pkg-desc">Mô tả gói...</div>
                </div>
                <div class="summary-right">
                  <div class="summary-coin" id="selected-pkg-coin">0 Cá</div>
                  <div class="summary-price" id="selected-pkg-price">0đ</div>
                </div>
              </div>

              <h3 class="method-title">Chọn phương thức thanh toán</h3>
              <div class="methods-list">
                <label class="method-item active">
                  <input type="radio" name="payment-provider" value="ZALOPAY" checked />
                  <div class="method-details">
                    <i class="ph-light ph-credit-card" style="font-size: 1.25rem; color: #008FE5;"></i>
                    <span>Ví điện tử ZaloPay (Quét mã / App)</span>
                  </div>
                </label>
                <label class="method-item">
                  <input type="radio" name="payment-provider" value="MOMO" />
                  <div class="method-details">
                    <i class="ph-light ph-wallet" style="font-size: 1.25rem; color: #A50064;"></i>
                    <span>Ví điện tử MoMo (Web to App)</span>
                  </div>
                </label>
              </div>
              
              <button class="cozy-btn pay-btn" id="confirm-pay-btn" disabled>
                Tiến hành thanh toán <i class="ph-light ph-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- VÙNG 2: LỊCH SỬ GIAO DỊCH -->
      <div class="wallet-content-section hidden" id="section-history">
        <div class="history-list" id="history-list-container">
          <div class="loading-placeholder text-center">
            <i class="ph-light ph-spinner-gap spin" style="font-size: 1.5rem; color: var(--cozy-green-matcha-forest);"></i>
            <p class="whisper-mono" style="font-size: 0.8rem; margin-top: 0.5rem;">Đang tải lịch sử giao dịch...</p>
          </div>
        </div>
      </div>

      <!-- MODAL CHỜ THANH TOÁN (POLISHING STATE) -->
      <div class="cozy-modal-overlay hidden" id="payment-modal">
        <div class="cozy-modal-card">
          <div class="modal-header">
            <h3>Đang chờ thanh toán</h3>
            <p>Vui lòng hoàn tất thanh toán trên ứng dụng Ví điện tử của bạn</p>
          </div>
          <div class="modal-body text-center">
            <div class="spinner-large">
              <i class="ph-light ph-spinner-gap spin" style="font-size: 3rem; color: var(--cozy-green-matcha-forest);"></i>
            </div>
            <p class="status-text">Hệ thống đang kiểm tra trạng thái thanh toán tự động...</p>
            <p class="info-text">Sau khi thanh toán thành công, trang này sẽ tự động cập nhật số dư.</p>
            
            <a href="#" id="modal-payment-link" target="_blank" class="cozy-btn link-btn">
              Mở link thanh toán lại <i class="ph-light ph-arrow-square-out"></i>
            </a>
          </div>
          <div class="modal-footer">
            <button class="close-modal-btn" id="close-modal-btn">Hủy giao dịch</button>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  import { getSupabase } from '../../scripts/supabase';

  document.addEventListener('DOMContentLoaded', () => {
    const balanceEl = document.getElementById('current-balance');
    const packagesContainer = document.getElementById('packages-container');
    const confirmPayBtn = document.getElementById('confirm-pay-btn') as HTMLButtonElement;
    
    // Bottom Sheet elements
    const paymentSheetOverlay = document.getElementById('payment-sheet-overlay');
    const paymentSheet = document.getElementById('payment-sheet');
    const sheetCloseBtn = document.getElementById('sheet-close-btn');
    const selectedPkgName = document.getElementById('selected-pkg-name');
    const selectedPkgDesc = document.getElementById('selected-pkg-desc');
    const selectedPkgCoin = document.getElementById('selected-pkg-coin');
    const selectedPkgPrice = document.getElementById('selected-pkg-price');
    
    // Tab buttons and sections
    const tabRechargeBtn = document.getElementById('tab-recharge-btn');
    const tabHistoryBtn = document.getElementById('tab-history-btn');
    const sectionRecharge = document.getElementById('section-recharge');
    const sectionHistory = document.getElementById('section-history');
    const historyContainer = document.getElementById('history-list-container');

    // Modal elements
    const paymentModal = document.getElementById('payment-modal');
    const modalPaymentLink = document.getElementById('modal-payment-link') as HTMLAnchorElement;
    const closeModalBtn = document.getElementById('close-modal-btn');

    let selectedPackageId = '';
    let currentBalance = 0;
    let pollInterval: any = null;
    let activeSessionUser: any = null;

    const client = getSupabase();
    if (!client) {
      window.location.href = '/';
      return;
    }

    // 1. Kiểm tra session và tải dữ liệu
    client.auth.getSession().then(({ data: { session } }: any) => {
      const user = session?.user;
      if (!user) {
        window.location.href = '/';
        return;
      }
      activeSessionUser = user;
      
      // Tải số dư xu ban đầu
      refreshBalance(user.id);

      // Tải danh sách các gói nạp
      loadPackages();

      // Kiểm tra tab query param
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('tab') === 'history') {
        activateTab('history');
      }
    });

    // 2. Chuyển đổi giữa các Tabs
    tabRechargeBtn?.addEventListener('click', () => activateTab('recharge'));
    tabHistoryBtn?.addEventListener('click', () => activateTab('history'));

    function activateTab(tab: 'recharge' | 'history') {
      if (tab === 'recharge') {
        tabRechargeBtn?.classList.add('active');
        tabHistoryBtn?.classList.remove('active');
        sectionRecharge?.classList.remove('hidden');
        sectionHistory?.classList.add('hidden');
      } else {
        tabHistoryBtn?.classList.add('active');
        tabRechargeBtn?.classList.remove('active');
        sectionHistory?.classList.remove('hidden');
        sectionRecharge?.classList.add('hidden');
        if (activeSessionUser) {
          loadHistory(activeSessionUser.id);
        }
      }
    }

    // 3. Hàm tải các gói nạp từ API
    async function loadPackages() {
      try {
        const res = await fetch('/api/billing/packages');
        const packages = await res.json();
        
        if (!packagesContainer) return;
        packagesContainer.innerHTML = '';

        packages.forEach((pkg: any) => {
          const card = document.createElement('div');
          card.className = 'package-card';
          card.dataset.id = pkg.id;
          
          const bonusBadge = pkg.bonus_coin > 0 
            ? `<div class="bonus-badge">+${pkg.bonus_coin} Cá Tặng</div>` 
            : '';

          card.innerHTML = `
            ${bonusBadge}
            <div class="package-name">${pkg.name}</div>
            <div class="package-coin">
              <i class="ph-fill ph-fish" style="color: var(--cozy-green-matcha-forest);"></i>
              <span>${pkg.coin_amount} Cá</span>
            </div>
            <div class="package-price">${pkg.amount_vnd.toLocaleString('vi-VN')} đ</div>
            <div class="package-desc">${pkg.description}</div>
          `;

          card.addEventListener('click', () => {
            document.querySelectorAll('.package-card').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            selectedPackageId = pkg.id;
            
            // Cập nhật thông tin gói trên Bottom Sheet
            if (selectedPkgName) selectedPkgName.textContent = pkg.name;
            if (selectedPkgDesc) selectedPkgDesc.textContent = pkg.description;
            if (selectedPkgCoin) selectedPkgCoin.textContent = `${pkg.coin_amount} Cá`;
            if (selectedPkgPrice) selectedPkgPrice.textContent = `${pkg.amount_vnd.toLocaleString('vi-VN')}đ`;

            // Mở Bottom Sheet
            if (paymentSheetOverlay) paymentSheetOverlay.classList.remove('hidden');
            if (paymentSheet) {
              setTimeout(() => paymentSheet.classList.add('open'), 10);
            }
            document.body.classList.add('overflow-hidden'); // Lock background scroll

            if (confirmPayBtn) {
              confirmPayBtn.removeAttribute('disabled');
            }
          });

          packagesContainer.appendChild(card);
        });
      } catch (err) {
        console.error('Lỗi load packages:', err);
      }
    }

    // 4. Lắng nghe thay đổi phương thức thanh toán và Đóng Bottom Sheet
    const methodItems = document.querySelectorAll('.method-item');
    methodItems.forEach(item => {
      item.addEventListener('click', () => {
        methodItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        const input = item.querySelector('input[type="radio"]') as HTMLInputElement;
        if (input) input.checked = true;
      });
    });

    function closePaymentSheet() {
      if (paymentSheet) paymentSheet.classList.remove('open');
      setTimeout(() => {
        if (paymentSheetOverlay) paymentSheetOverlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 300); // Khớp thời gian animation transition 0.3s
    }

    sheetCloseBtn?.addEventListener('click', closePaymentSheet);
    paymentSheetOverlay?.addEventListener('click', (e) => {
      if (e.target === paymentSheetOverlay) {
        closePaymentSheet();
      }
    });

    // 5. Nút bấm tiến hành thanh toán
    confirmPayBtn?.addEventListener('click', async () => {
      if (!selectedPackageId || !activeSessionUser) return;
      
      confirmPayBtn.disabled = true;
      confirmPayBtn.innerHTML = `Đang khởi tạo... <i class="ph-light ph-spinner-gap spin"></i>`;

      const provider = (document.querySelector('input[name="payment-provider"]:checked') as HTMLInputElement)?.value || 'ZALOPAY';

      try {
        const response = await fetch('/api/billing/recharge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: activeSessionUser.id,
            packageId: selectedPackageId,
            provider
          })
        });

        const data = await response.json();
        if (data.error) throw new Error(data.error);

        // Mở cổng thanh toán trong tab mới
        window.open(data.paymentUrl, '_blank');

        // Đóng Bottom Sheet nạp tiền
        closePaymentSheet();

        // Hiển thị modal chờ thanh toán
        if (paymentModal) paymentModal.classList.remove('hidden');
        if (modalPaymentLink) modalPaymentLink.href = data.paymentUrl;

        // Bắt đầu vòng lặp đối soát (auto-polling) kiểm tra số dư cá tăng
        startPolling(activeSessionUser.id);

      } catch (err: any) {
        console.error('Lỗi thanh toán:', err);
        alert(err.message || 'Có lỗi xảy ra trong quá trình kết nối với cổng thanh toán.');
      } finally {
        confirmPayBtn.disabled = false;
        confirmPayBtn.innerHTML = `Tiến hành thanh toán <i class="ph-light ph-arrow-right"></i>`;
      }
    });

    // 6. Đóng modal và dừng vòng lặp
    closeModalBtn?.addEventListener('click', () => {
      stopPolling();
      if (paymentModal) paymentModal.classList.add('hidden');
    });

    function startPolling(userId: string) {
      stopPolling();
      const oldBalance = currentBalance;

      pollInterval = setInterval(async () => {
        fetch(`/api/billing/balance?userId=${userId}`)
          .then(res => res.json())
          .then((data: any) => {
            if (data.balance !== undefined && Number(data.balance) > oldBalance) {
              stopPolling();
              if (paymentModal) paymentModal.classList.add('hidden');
              
              // Cập nhật số dư hiển thị mới
              currentBalance = Number(data.balance);
              if (balanceEl) balanceEl.textContent = `${currentBalance} Cá`;

              // Bắn hoạt ảnh ăn mừng hoặc thông báo
              alert('🎉 Nạp cá thành công! Số dư của bạn đã được cập nhật.');
              window.location.href = '/profile';
            }
          });
      }, 3000);
    }

    function stopPolling() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    // 7. Hàm tải số dư cá
    function refreshBalance(userId: string) {
      fetch(`/api/billing/balance?userId=${userId}`)
        .then(res => res.json())
        .then((data: any) => {
          currentBalance = data.balance !== undefined ? Number(data.balance) : 0;
          if (balanceEl) balanceEl.textContent = `${currentBalance} Cá`;
        })
        .catch(err => {
          console.error('Error loading balance:', err);
        });
    }

    // 8. Tải lịch sử giao dịch
    async function loadHistory(userId: string) {
      if (!historyContainer) return;
      
      try {
        const res = await fetch(`/api/billing/history?userId=${userId}`);
        const data = await res.json();
        
        if (data.error) throw new Error(data.error);
        const txs = data.history || [];

        if (txs.length === 0) {
          historyContainer.innerHTML = '<div class="no-history text-center whisper-mono" style="font-size: 0.82rem; padding: 2rem 0; opacity: 0.7;">Chưa có lịch sử giao dịch nào. 🐾</div>';
          return;
        }

        historyContainer.innerHTML = '';
        txs.forEach((tx: any) => {
          const date = new Date(tx.created_at).toLocaleString('vi-VN', {
            hour: '2-digit',
            minute: '2-digit',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
          });

          const isPlus = tx.amount > 0;
          const classAmount = isPlus ? 'tx-amount plus' : 'tx-amount minus';
          const symbol = isPlus ? '+' : '';

          const item = document.createElement('div');
          item.className = 'history-item';
          item.innerHTML = `
            <div class="tx-left">
              <div class="tx-type">${tx.description || (isPlus ? 'Nạp cá' : 'Tiêu dùng')}</div>
              <div class="tx-date">${date}</div>
            </div>
            <div class="${classAmount}">${symbol}${tx.amount} Cá</div>
          `;
          historyContainer.appendChild(item);
        });

      } catch (err) {
        console.error('Lỗi load lịch sử:', err);
        historyContainer.innerHTML = '<div class="no-history text-center">Không thể tải dữ liệu lịch sử.</div>';
      }
    }
  });
</script>

<style is:global>
  .wallet-view {
    padding: 3rem 1.5rem 6rem;
    background-color: var(--cozy-bg-beige);
    min-height: 90vh;
    display: flex;
    justify-content: center;
  }
  .wallet-page-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .wallet-nav-header {
    margin-bottom: 0.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--cozy-text-obsidian);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
    opacity: 0.8;
  }
  .back-link:hover {
    opacity: 1;
    transform: translateX(-4px);
    color: var(--cozy-green-matcha-forest);
  }

  /* --- TABS --- */
  .wallet-tabs {
    display: flex;
    background-color: var(--cozy-bg-pure);
    border: 1px solid var(--cozy-border-light);
    padding: 4px;
    border-radius: 12px;
    gap: 4px;
  }
  .wallet-tab-btn {
    flex: 1;
    border: none;
    background: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    color: var(--cozy-text-charcoal);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .wallet-tab-btn:hover {
    background-color: var(--cozy-bg-oatmeal);
  }
  .wallet-tab-btn.active {
    background-color: var(--cozy-text-obsidian);
    color: #fff;
  }

  /* --- CONTENT SECTIONS --- */
  .wallet-content-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .wallet-balance-card {
    background-color: var(--cozy-bg-pure);
    border: 1px solid var(--cozy-border-light);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 12px rgba(21, 23, 15, 0.01);
  }
  .balance-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--cozy-text-charcoal);
  }
  .balance-value {
    font-family: 'Space Mono', monospace;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--cozy-green-matcha-forest);
  }
  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--cozy-text-obsidian);
    margin-top: 0.5rem;
  }

  /* --- PACKAGES GRID --- */
  .packages-grid {
    display: grid;
    grid-template-cols: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .package-card {
    background-color: var(--cozy-bg-pure);
    border: 1px solid var(--cozy-border-light);
    border-radius: 14px;
    padding: 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }
  .package-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: transparent;
    transition: all 0.2s ease;
  }
  .package-card:hover {
    transform: translateY(-2px) rotate(1deg);
    box-shadow: 0 6px 20px rgba(21, 23, 15, 0.03);
    border-color: var(--cozy-green-matcha-forest);
  }
  .package-card.active {
    border-color: var(--cozy-green-matcha-forest);
    box-shadow: 0 4px 16px rgba(118, 193, 35, 0.08);
  }
  .package-card.active::before {
    background-color: var(--cozy-green-matcha-forest);
  }
  .bonus-badge {
    position: absolute;
    top: 8px;
    right: -25px;
    background-color: #E74C3C;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 25px;
    transform: rotate(45deg);
  }
  .package-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--cozy-text-charcoal);
  }
  .package-coin {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--cozy-text-obsidian);
  }
  .package-price {
    font-size: 1rem;
    font-weight: 600;
    color: var(--cozy-green-matcha-forest);
    background-color: #F0F9EB;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
  }
  .package-desc {
    font-size: 0.75rem;
    color: var(--cozy-text-charcoal);
    opacity: 0.8;
  }

  /* --- COZY BOTTOM SHEET --- */
  .cozy-bottom-sheet-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(21, 23, 15, 0.4);
    backdrop-filter: blur(6px);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 999;
    transition: all 0.3s ease;
  }
  .cozy-bottom-sheet {
    background-color: var(--cozy-bg-pure);
    border: 1px solid var(--cozy-border-light);
    border-radius: 24px 24px 0 0;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 -8px 32px rgba(21, 23, 15, 0.08);
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cozy-bottom-sheet.open {
    transform: translateY(0);
  }
  .sheet-header {
    padding: 1.25rem 1.5rem 0.75rem;
    border-bottom: 1px dashed var(--cozy-border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }
  .sheet-handle {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 4px;
    background-color: var(--cozy-border-light);
    border-radius: 2px;
  }
  .sheet-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--cozy-text-obsidian);
  }
  .sheet-close-btn {
    border: none;
