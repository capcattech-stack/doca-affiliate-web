    .playlist-vinyl-title {
      font-size: 0.82rem !important;
      text-align: center;
    }

    .playlist-vinyl-count {
      font-size: 0.65rem !important;
    }

    /* Băng chuyền tràn lề full-bleed lướt mượt mà ra sát mép di động */
    .playlists-list-container {
      box-sizing: border-box;
      overscroll-behavior-x: contain; /* Chặn kéo lan ra background toàn trang */
      width: calc(100% + 72px) !important;
      max-width: none !important;
      margin-left: -36px !important;
      margin-right: -36px !important;
      padding: 0.5rem 36px 1rem 36px !important; /* Lề trái/phải 36px để bù lại margin âm, đảm bảo căn tăm tắp với tiêu đề */
      gap: 1rem !important; /* Khoảng cách giữa các album */
    }
  }

  /* Cozy Mini Player Float Widget neo dưới bottom */
  .cozy-mini-player-float {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(120px); /* Ẩn mặc định bên dưới */
    width: calc(100% - 32px);
    max-width: 440px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--cozy-border-light);
    border-radius: 30px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 0 16px !important; /* Lề trái và phải bằng 16px để căn đĩa than cách đều mép cong an toàn */
