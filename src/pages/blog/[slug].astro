---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import NamiyaMailbox from '../../components/NamiyaMailbox.astro';
import PolaroidSheet from '../../components/PolaroidSheet.astro';

// 1. Định nghĩa getStaticPaths để sinh tĩnh tất cả các trang bài viết
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, publishDate, coverImage, category, tags, relatedProducts = [], pillar } = entry.data;

// 2. Fetch toàn bộ dữ liệu sản phẩm từ Supabase tại thời điểm build (SSG) để liên kết sản phẩm thật
let allProducts: any[] = [];
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

if (supabaseUrl && supabaseKey) {
  try {
    const res = await fetch(`${supabaseUrl}/rest/v1/products?select=*`, {
      headers: {
        'apikey': supabaseKey,
        'Authorization': `Bearer ${supabaseKey}`
      }
    });
    if (res.ok) {
      allProducts = await res.json();
    }
  } catch (err) {
    console.warn("Failed to fetch all products from Supabase", err);
  }
}

// Fallback tĩnh phòng trường hợp Supabase chưa kết cấu dữ liệu
