  }

  .curation-title {
    font-family: 'Inter', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--cozy-text-obsidian);
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
