    // --- MOBILE INFINITE CAROUSEL ---
    const fannedDeck = document.getElementById('fanned-products-deck') as HTMLElement;
    if (fannedDeck && window.innerWidth < 1024) {
      const originalCards = Array.from(fannedDeck.children);
      if (originalCards.length > 0) {
        // Clone original cards to prepend and append for infinite wrapping
        originalCards.forEach(card => {
          fannedDeck.appendChild(card.cloneNode(true));
        });
        originalCards.slice().reverse().forEach(card => {
          fannedDeck.insertBefore(card.cloneNode(true), fannedDeck.firstChild);
        });

        setTimeout(() => {
          const cardEl = fannedDeck.children[0] as HTMLElement;
          const cardWidth = cardEl.getBoundingClientRect().width || 200;
          const gap = parseInt(window.getComputedStyle(fannedDeck).gap) || 16;
          const stepWidth = cardWidth + gap;

          // Start scrolled exactly to the first real card (index 5)
          const middleIndex = 5;
          fannedDeck.scrollLeft = stepWidth * middleIndex;

          let scrollTimeout: any = null;

          const updateActiveCard = () => {
            const deckCenter = fannedDeck.scrollLeft + fannedDeck.clientWidth / 2;
            let closestCard: HTMLElement | null = null;
            let minDistance = Infinity;

            Array.from(fannedDeck.children).forEach(child => {
              const card = child as HTMLElement;
              const cardCenter = card.offsetLeft + card.clientWidth / 2;
              const distance = Math.abs(deckCenter - cardCenter);
              if (distance < minDistance) {
                minDistance = distance;
                closestCard = card;
              }
            });

            Array.from(fannedDeck.children).forEach(child => {
              const card = child as HTMLElement;
              if (card === closestCard) {
                card.classList.add('active-card');
              } else {
                card.classList.remove('active-card');
              }
            });
          };

          fannedDeck.addEventListener('scroll', () => {
            // Update center card scaling in real-time as user scrolls
            updateActiveCard();

            // Seamless wrap jump ONLY after scrolling finishes (idle for 100ms)
            // This prevents touch-drag conflicts and allows native momentum & bounce physics
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
              const currentScroll = fannedDeck.scrollLeft;
              
              if (currentScroll >= stepWidth * 10) {
                fannedDeck.scrollLeft = currentScroll - (stepWidth * 5);
              } else if (currentScroll <= stepWidth * 0.5) {
                fannedDeck.scrollLeft = currentScroll + (stepWidth * 5);
              }
            }, 100);
          }, { passive: true });

          // Initialize active card state
          updateActiveCard();
        }, 120);
      }
    }

